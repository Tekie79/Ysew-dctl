// YSEW alpha.2 graphical-control probe. Requires DCTL color-picker support (Resolve 19.1+).
// Swatch emits the chosen RGB numbers as-is, without any color transform.
DEFINE_UI_PARAMS(probe_color, Test Color, DCTLUI_COLOR_PICKER, 0.20, 0.60, 0.90)
DEFINE_UI_PARAMS(probe_view, View, DCTLUI_COMBO_BOX, 1, {CP_INPUT, CP_SWATCH}, {Input, Swatch})
DEFINE_UI_PARAMS(probe_on, Enabled, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_TOOLTIP(Test Color, "Choose a color in the native dialog. Swatch must follow it. This probe does not convert RGB values.")

__DEVICE__ float3 transform(int p_Width,int p_Height,int p_X,int p_Y,float p_R,float p_G,float p_B) {
    if (p_Width <= 0 || p_Height <= 0 || p_X < 0 || p_Y < 0 || !probe_on || probe_view == 0) return make_float3(p_R,p_G,p_B);
    return make_float3(probe_color.r,probe_color.g,probe_color.b);
}
