DEFINE_UI_PARAMS(diag_tap, Measure, DCTLUI_COMBO_BOX, 0, {TAP_SOURCE, TAP_BALANCE}, {Source, Balanced})
DEFINE_UI_PARAMS(inspect_stage, Stage, DCTLUI_COMBO_BOX, 0, {ST_SOURCE, ST_BALANCE, ST_NEG, ST_LOOK, ST_PRINT, ST_LENS, ST_PRE, ST_OUT}, {Source, Balance, Negative, Look, Print, Vignette, Pre Gamut, Final})
DEFINE_UI_PARAMS(reference_gray, Ref Gray, DCTLUI_SLIDER_FLOAT, 0.18, 0.01, 0.5, 0.005)
DEFINE_UI_PARAMS(ev_span, EV Span, DCTLUI_SLIDER_INT, 6, 2, 12, 1)
DEFINE_UI_PARAMS(ev_step, EV Steps, DCTLUI_COMBO_BOX, 1, {EV_CONT, EV_ONE, EV_HALF, EV_THIRD}, {Continuous, One Stop, Half Stop, Third Stop})
