DEFINE_UI_PARAMS(guide_opacity, Guide Opacity, DCTLUI_SLIDER_FLOAT, 0.95, 0.25, 1.0, 0.01)

// M2 controls are appended to preserve all alpha.1/alpha.2 saved parameter indices.
