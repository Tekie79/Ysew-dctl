DEFINE_UI_PARAMS(optics_mix, Optics Mix, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(optics_soft, Soft x100, DCTLUI_SLIDER_INT, 75, 5, 300, 5)
DEFINE_UI_PARAMS(halation_amount, Hal Percent, DCTLUI_SLIDER_INT, 0, 0, 200, 1)
DEFINE_UI_PARAMS(halation_radius, Hal Radius, DCTLUI_SLIDER_INT, 18, 1, 120, 1)
DEFINE_UI_PARAMS(halation_threshold, Hal EV x10, DCTLUI_SLIDER_INT, 20, -20, 80, 1)
DEFINE_UI_PARAMS(halation_tint, Hal Tint, DCTLUI_SLIDER_FLOAT, 0.35, 0.0, 1.0, 0.01)
