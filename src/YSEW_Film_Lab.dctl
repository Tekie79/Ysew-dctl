        if (index == 1) return 85;
        if (index == 2) return 77;
        if (index == 3) return 65;
    }
    if (label == 7) {
        if (index == 0) return 89;
        if (index == 1) return 83;
        if (index == 2) return 69;
        if (index == 3) return 87;
        if (index == 5) return 65;
        if (index == 6) return 50;
    }
    if (label == 8) {
        if (index == 0) return 86;
        if (index == 1) return 73;
        if (index == 2) return 71;
        if (index == 3) return 78;
        if (index == 4) return 69;
        if (index == 5) return 84;
        if (index == 6) return 84;
        if (index == 7) return 69;
        if (index == 9) return 71;
        if (index == 10) return 85;
        if (index == 11) return 73;
        if (index == 12) return 68;
        if (index == 13) return 69;
    }
    if (label == 9) {
        if (index == 0) return 77;
        if (index == 1) return 65;
        if (index == 2) return 84;
        if (index == 3) return 67;
        if (index == 4) return 72;
        if (index == 6) return 87;
        if (index == 7) return 69;
        if (index == 8) return 73;
        if (index == 9) return 71;
        if (index == 10) return 72;
        if (index == 11) return 84;
    }
    if (label == 10) {
