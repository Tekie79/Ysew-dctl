__DEVICE__ int ys_text_pixel(int label,int x,int y,int left,int top,int scale) {
    if (x < left || y < top) return 0;
    int xx = (x-left)/scale, yy = (y-top)/scale;
    if (yy > 4) return 0;
    return ys_glyph(ys_label_char(label,xx/4),xx%4,yy);
}
__DEVICE__ int ys_number_pixel(int n,int x,int y,int left,int top,int scale) {
    if (x < left || y < top) return 0;
    return ys_number(n,(x-left)/scale,(y-top)/scale);
}
__DEVICE__ float ys_line(float distance,float thickness) {
    return 1.0f-ys_smooth(thickness,thickness+1.0f,_fabs(distance));
}
__DEVICE__ float3 ys_warning(float3 image,int height,int x,int y) {
    if (y < _fmaxf(3.0f,(float)height*0.009f))
        return ((x/12)%2) == 0 ? make_float3(1.0f,0.6f,0.0f) : ys_gray(0.04f);
    return image;
}
typedef struct {
    float balance_ev; float balance_w; float balance_t; float density_r; float density_g; float density_b;
    int wb_kind; float wb_kelvin; float wb_offset; float wb_mix;
    int film_kind;
    int neg_active; float neg_c; float neg_t; float neg_s; float neg_chroma; float neg_cross;
    float adv_nd; float adv_nc; float adv_ns; float adv_nsh; float adv_nhi; float adv_nw; float adv_ng; float adv_nb;
    int look_id; float look_amount; float skin_amount; float skin_center; float skin_half; float skin_min; float skin_max;
    int print_active; float print_c; float print_t; float print_s; float print_d; float print_chroma;
    float adv_pb; float adv_pw; float adv_ps; float adv_pwarm; float adv_pc;
    float gray_code; int compress; float knee;
    float vig_inner; float vig_feather; float vig_round; float vig_cx; float vig_cy;
} YSGuideParams;
__DEVICE__ float3 ys_guide_curve(float linear_gray,YSGuideParams p) {
    // Full pointwise response to a neutral DWG input; excludes spatial vignette.
    // Tests compare this helper with the actual transform at matching settings.
    float3 v = ys_balance_m2(ys_gray(linear_gray),p.balance_ev,p.balance_w,p.balance_t,p.density_r,p.density_g,p.density_b,
        p.wb_kind,p.wb_kelvin,p.wb_offset,p.wb_mix);
    float mask = 0.0f;
    if (p.look_id != 0 && p.look_amount > 0.0f && p.skin_amount > 0.0f)
        mask = ys_skin(v,p.skin_center,p.skin_half,p.skin_min,p.skin_max);
    if (p.neg_active) {
        v = p.film_kind == 0
            ? ys_interaction(ys_saturation(ys_curve(v,p.neg_c,p.neg_t,p.neg_s),p.neg_chroma),p.neg_cross)
            : ys_advanced_negative(v,p.neg_c,p.neg_t,p.neg_s,p.neg_chroma,p.neg_cross,
                p.adv_nd,p.adv_nc,p.adv_ns,p.adv_nsh,p.adv_nhi,p.adv_nw,p.adv_ng,p.adv_nb);
    }
    v = ys_show(v,p.look_id,p.look_amount,p.skin_amount,mask);
    if (p.print_active) {
        v = p.film_kind == 0
            ? ys_scale(ys_saturation(ys_curve(v,p.print_c,p.print_t,p.print_s),p.print_chroma),_powf(10.0f,-p.print_d))
            : ys_advanced_print(v,p.print_c,p.print_t,p.print_s,p.print_d,p.print_chroma,
                p.adv_pb,p.adv_pw,p.adv_ps,p.adv_pwarm,p.adv_pc);
    }
    return ys_view(v,p.gray_code,p.compress,p.knee);
}
__DEVICE__ float3 ys_vignette_guide(float3 image,YSGuideParams p,int w,int h,int x,int y,float opacity) {
    float aspect = (float)w/(float)h;
    float nx = (2.0f*((float)x+0.5f)/(float)w-1.0f-p.vig_cx)*aspect;
    float ny = 2.0f*((float)y+0.5f)/(float)h-1.0f-p.vig_cy;
    nx /= 1.0f+(aspect-1.0f)*(1.0f-p.vig_round);
    float radius = _sqrtf(nx*nx+ny*ny);
    float pixel_scale = (float)h*0.5f;
    float inner = ys_line((radius-p.vig_inner)*pixel_scale,1.2f);
    float outer = ys_line((radius-p.vig_inner-p.vig_feather)*pixel_scale,1.2f);
    float cx = (1.0f+p.vig_cx)*(float)w*0.5f-0.5f;
    float cy = (1.0f+p.vig_cy)*(float)h*0.5f-0.5f;
    float cross = _fmaxf(_fabs((float)x-cx)<12.0f ? ys_line((float)y-cy,1.0f) : 0.0f,
        _fabs((float)y-cy)<12.0f ? ys_line((float)x-cx,1.0f) : 0.0f);
    float3 out = ys_mix(image,make_float3(1.0f,0.7f,0.15f),inner*opacity);
    out = ys_mix(out,make_float3(0.1f,0.8f,1.0f),outer*opacity);
    out = ys_mix(out,ys_gray(1.0f),cross*opacity);
    int scale = (int)_fmaxf(1.0f,(float)h/200.0f);
    if (ys_text_pixel(8,x,y,8*scale,7*scale,scale)) out = ys_gray(0.95f);
    return ys_warning(out,h,x,y);
}
__DEVICE__ float3 ys_graphic(float3 image,YSDiag d,YSGuideParams p,int mode,float opacity,int w,int h,int x,int y) {
    if (mode == 0) return image;
    if (mode == 5) return ys_vignette_guide(image,p,w,h,x,y,opacity);
    if (w < 480 || h < 270) return ys_warning(image,h,x,y);
    int pw = (int)_fminf((float)w-24.0f,_fmaxf(300.0f,(float)w*0.42f));
    int ph = (int)_fminf((float)h-30.0f,_fmaxf(190.0f,(float)h*0.42f));
    int left = w-pw-12, top = (int)((float)h*0.035f);
    if (x < left || x >= left+pw || y < top || y >= top+ph) return ys_warning(image,h,x,y);
    int sc = (int)_fmaxf(1.0f,(float)ph/90.0f);
    float3 panel = make_float3(0.055f,0.063f,0.075f);
    int title = mode == 1 ? 0 : (mode == 2 ? 3 : (mode == 3 ? 4 : 5));
    if (ys_text_pixel(title,x,y,left+6*sc,top+4*sc,sc)) panel = ys_gray(0.94f);
    if (ys_text_pixel(7,x,y,left+pw-32*sc,top+ph-8*sc,sc)) panel = make_float3(0.72f,0.76f,0.80f);
    if (mode <= 2) {
        int gx = left+20*sc, gy = top+15*sc;
        int gw = pw-27*sc, gh = ph-33*sc;
        if (ys_text_pixel(1,x,y,gx+gw/2-16*sc,top+ph-8*sc,sc)) panel = ys_gray(0.75f);
        if (ys_text_pixel(mode == 1 ? 2 : 9,x,y,gx,top+10*sc,sc)) panel = ys_gray(0.65f);
        if (ys_number_pixel(-d.span,x,y,gx-4*sc,gy+gh+3*sc,sc)
            || ys_number_pixel(0,x,y,gx+gw/2-sc,gy+gh+3*sc,sc)
            || ys_number_pixel(d.span,x,y,gx+gw-3*sc,gy+gh+3*sc,sc)
            || ys_number_pixel(0,x,y,gx-7*sc,gy+gh-4*sc,sc)
            || ys_number_pixel(1,x,y,gx-7*sc,gy,sc)) panel = ys_gray(0.7f);
        if (x >= gx && x <= gx+gw && y >= gy && y <= gy+gh) {
            float u = (float)(x-gx)/(float)gw;
            float value = 1.0f-(float)(y-gy)/(float)gh;
            float ev = (2.0f*u-1.0f)*(float)d.span;
            float3 bg = make_float3(0.09f,0.10f,0.12f);
            float grid = _fmaxf(ys_line((value*4.0f-_floorf(value*4.0f+0.5f))*(float)gh/4.0f,0.25f),
                ys_line((ev-_floorf(ev+0.5f))*(float)gw/(2.0f*(float)d.span),0.25f));
            bg = ys_mix(bg,ys_gray(0.23f),grid*0.55f);
            if (mode == 1) {
                float lin = d.gray*_exp2f(ev);
                float3 curve = ys_guide_curve(lin,p);
                float reference = ys_view(ys_gray(lin),p.gray_code,p.compress,p.knee).x;
                bg = ys_mix(bg,ys_gray(0.55f),ys_line((value-reference)*(float)gh,0.8f));
                float dr=ys_line((value-curve.x)*(float)gh,1.0f);
                float dg=ys_line((value-curve.y)*(float)gh,1.0f);
                float db=ys_line((value-curve.z)*(float)gh,1.0f);
                float covered=_fmaxf(dr,_fmaxf(dg,db));
                float3 ink=make_float3(0.15f+0.85f*dr,0.15f+0.85f*dg,0.15f+0.85f*db);
                bg=ys_mix(bg,ink,covered);
            } else {
                float weight=ys_band(ev,d.evlo,d.evhi,d.evsoft);
                bg=ys_mix(bg,ys_heat(u),0.12f+0.24f*weight);
                bg=ys_mix(bg,make_float3(0.1f,0.9f,0.55f),ys_line((value-weight)*(float)gh,1.0f));
            }
            panel=bg;
        }
    } else {
        float hue = mode == 3 ? d.hue : d.skinh;
        float hue_half_width = mode == 3 ? d.width : d.skinw;
        float feather = mode == 3 ? d.soft : 8.0f;
        float sm = mode == 3 ? d.smin : d.skinsmin, sx = mode == 3 ? d.smax : d.skinsmax;
        float radius = (float)(ph-40*sc)*0.5f;
        float cx = (float)left+(float)pw*0.5f, cy=(float)(top+14*sc)+radius;
        float dx=((float)x-cx)/radius, dy=(cy-(float)y)/radius;
        float sat=_sqrtf(dx*dx+dy*dy);
        if (sat <= 1.0f) {
            float angle=_atan2f(dy,dx)*57.295779513f;
            if (angle < 0.0f) angle+=360.0f;
            float mask=ys_hue_weight(angle,hue,hue_half_width,feather)*ys_band(sat,sm,sx,mode == 3 ? 0.02f : 0.03f);
            float3 disk=ys_mix(ys_gray(1.0f),ys_hue_color(angle),sat);
            panel=ys_scale(disk,0.15f+0.73f*mask);
            float distance=_fabs(angle-hue); distance=_fminf(distance,360.0f-distance);
            if (sat > 0.15f && distance*0.017453293f*sat*radius < 1.0f) panel=ys_gray(0.94f);
        }
        int barx=left+10*sc, barw=pw-20*sc, bary=top+ph-20*sc;
        if (mode == 3) {
            if (ys_text_pixel(6,x,y,barx,bary-7*sc,sc)) panel=ys_gray(0.8f);
            if (x>=barx && x<barx+barw && y>=bary && y<bary+5*sc) {
                float yp=(float)(x-barx)/(float)(barw-1);
                float match=ys_band(yp,d.ymin,d.ymax,0.02f);
                panel=ys_mix(ys_gray(0.08f+0.22f*yp),make_float3(0.95f,0.66f,0.15f),0.65f*match);
            }
        } else if (ys_text_pixel(11,x,y,barx,bary,sc)) panel=ys_gray(0.7f);
    }
    return ys_warning(ys_mix(image,panel,opacity),h,x,y);
}

__DEVICE__ float3 transform(int p_Width,int p_Height,int p_X,int p_Y,float p_R,float p_G,float p_B) {
    float3 raw = make_float3(p_R,p_G,p_B);
    if (p_Width <= 0 || p_Height <= 0 || !ys_safe(raw)) return ys_error(p_X,p_Y);
    YSStages s;
    s.source = ys_input(raw,input_mode);
    if (!ys_safe(s.source)) return ys_error(p_X,p_Y);
    s.balanced = ys_balance_m2(s.source,exposure,warm,tint,printer_r,printer_g,printer_b,
        wb_mode,wb_temp,wb_duv,wb_strength);
    s.negative = s.balanced;
    if (negative_on) {
        s.negative = film_model == 0
            ? ys_interaction(ys_saturation(ys_curve(s.balanced,neg_contrast,neg_toe,neg_shoulder),neg_sat),crosstalk)
            : ys_advanced_negative(s.balanced,neg_contrast,neg_toe,neg_shoulder,neg_sat,crosstalk,
                adv_neg_density,adv_neg_color,adv_neg_sep,adv_neg_shadow,adv_neg_high,
                adv_neg_warm,adv_neg_green,adv_neg_cool);
    }
    float range_center = range_pick_on ? ys_picker_hue(make_float3(range_pick.r,range_pick.g,range_pick.b),range_hue) : range_hue;
    float skin_center = skin_pick_on ? ys_picker_hue(make_float3(skin_pick.r,skin_pick.g,skin_pick.b),skin_hue) : skin_hue;
    float skin = 0.0f;
    if (look_mode != 0 && look_mix > 0.0f && skin_protect > 0.0f)
        skin = ys_skin(s.balanced,skin_center,skin_width,skin_sat_min,skin_sat_max);
    s.look = ys_show(s.negative,look_mode,look_mix,skin_protect,skin);
    s.print = s.look;
    if (print_on) {
        s.print = film_model == 0
            ? ys_scale(ys_saturation(ys_curve(s.look,print_contrast,print_toe,print_shoulder),print_sat),_powf(10.0f,-print_density))
            : ys_advanced_print(s.look,print_contrast,print_toe,print_shoulder,print_density,print_sat,
                adv_print_black,adv_print_white,adv_print_sep,adv_print_warm,adv_print_color);
    }
    s.lens = ys_scale(s.print,_exp2f(-vignette_stops*ys_vignette(p_Width,p_Height,p_X,p_Y,vignette_radius,vignette_soft,vignette_round,vignette_x,vignette_y)));
    if (diag_mode == 0 && guide_mode == 0 && output_mode != 2) return ys_encode_working(s.lens,output_mode);
    s.pre = ys_pre_gamut(s.lens,output_gray);
    float factor = gamut_on ? ys_gamut_factor(s.pre,gamut_knee) : 1.0f;
    s.compression = 1.0f-factor;
    s.output = ys_gamma24(ys_gamut(s.pre,factor));
    if (diag_mode == 0 && guide_mode == 0) return output_mode == 2 ? s.output : ys_encode_working(s.lens,output_mode);
    // Diagnostic colors need an unmanaged terminal Rec709 path. Never silently pass
    // display-coded overlays into a DWG working chain and call them calibrated.
    if (output_mode != 2) {
        float3 warning = ys_from709(ys_error(p_X,p_Y));
        return ys_encode_working(warning,output_mode);
    }
    YSDiag d;
    d.mode=diag_mode; d.tap=diag_tap; d.stage=inspect_stage; d.span=ev_span; d.step=ev_step; d.legend=diag_legend;
    d.gray=reference_gray; d.evlo=ev_low; d.evhi=ev_high; d.evsoft=ev_soft;
    d.hue=range_center; d.width=range_width; d.soft=range_soft; d.smin=range_smin; d.smax=range_smax; d.ymin=range_ymin; d.ymax=range_ymax;
    d.skinh=skin_center; d.skinw=skin_width; d.skinsmin=skin_sat_min; d.skinsmax=skin_sat_max;
    d.neutral=neutral_tol; d.gain=diag_gain; d.opacity=diag_overlay; d.split=split_pos;
    float3 result = diag_mode == 0 ? s.output : ys_diagnostic(s,d,output_gray,gamut_on,gamut_knee,p_Width,p_Height,p_X,p_Y);
    if (guide_mode == 0) return result;
    YSGuideParams gp;
    gp.balance_ev=exposure; gp.balance_w=warm; gp.balance_t=tint;
    gp.density_r=printer_r; gp.density_g=printer_g; gp.density_b=printer_b;
    gp.wb_kind=wb_mode; gp.wb_kelvin=wb_temp; gp.wb_offset=wb_duv; gp.wb_mix=wb_strength;
    gp.film_kind=film_model;
    gp.neg_active=negative_on; gp.neg_c=neg_contrast; gp.neg_t=neg_toe; gp.neg_s=neg_shoulder; gp.neg_chroma=neg_sat; gp.neg_cross=crosstalk;
    gp.adv_nd=adv_neg_density; gp.adv_nc=adv_neg_color; gp.adv_ns=adv_neg_sep;
    gp.adv_nsh=adv_neg_shadow; gp.adv_nhi=adv_neg_high; gp.adv_nw=adv_neg_warm; gp.adv_ng=adv_neg_green; gp.adv_nb=adv_neg_cool;
    gp.look_id=look_mode; gp.look_amount=look_mix; gp.skin_amount=skin_protect; gp.skin_center=skin_center;
    gp.skin_half=skin_width; gp.skin_min=skin_sat_min; gp.skin_max=skin_sat_max;
    gp.print_active=print_on; gp.print_c=print_contrast; gp.print_t=print_toe; gp.print_s=print_shoulder; gp.print_d=print_density; gp.print_chroma=print_sat;
    gp.adv_pb=adv_print_black; gp.adv_pw=adv_print_white; gp.adv_ps=adv_print_sep; gp.adv_pwarm=adv_print_warm; gp.adv_pc=adv_print_color;
    gp.gray_code=output_gray; gp.compress=gamut_on; gp.knee=gamut_knee;
    gp.vig_inner=vignette_radius; gp.vig_feather=vignette_soft; gp.vig_round=vignette_round; gp.vig_cx=vignette_x; gp.vig_cy=vignette_y;
    return ys_graphic(result,d,gp,guide_mode,guide_opacity,p_Width,p_Height,p_X,p_Y);
}
