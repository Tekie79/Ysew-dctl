DEFINE_UI_PARAMS(grain_seed, Grain Seed, DCTLUI_SLIDER_INT, 1979, 0, 9999, 1)
DEFINE_UI_PARAMS(lens_soft, Lens Soft, DCTLUI_SLIDER_INT, 0, 0, 100, 1)
DEFINE_UI_PARAMS(lens_radius, Lens Radius, DCTLUI_SLIDER_INT, 3, 1, 24, 1)
DEFINE_UI_PARAMS(micro_soft, Micro Soft, DCTLUI_SLIDER_INT, 0, 0, 100, 1)
