// M5 film texture. Disabled by default. Grain uses RAND and timeline-frame seeding.
DEFINE_UI_PARAMS(texture_on, Texture, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(grain_gauge, Grain Gauge, DCTLUI_COMBO_BOX, 2, {GAUGE_8, GAUGE_16, GAUGE_35, GAUGE_65, GAUGE_CUSTOM}, {8mm, 16mm, 35mm, 65mm, Custom})
