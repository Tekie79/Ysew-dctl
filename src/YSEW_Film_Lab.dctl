DEFINE_UI_PARAMS(cal_tol, Cal Tol x100, DCTLUI_SLIDER_INT, 15, 1, 200, 1)
DEFINE_UI_PARAMS(cal_neutral, Cal Neutral x1k, DCTLUI_SLIDER_INT, 10, 1, 200, 1)

DEFINE_UI_TOOLTIP(Input, "RGB encoding arriving at this node. Camera log choices require the decoder or upstream converter to output that exact gamut and curve. ProRes RAW is not auto-detected.")
DEFINE_UI_TOOLTIP(Output, "DWG choices return working RGB for one external output transform. 709 Gamma 2.4 performs internal SDR rendering. Never apply a second output conversion.")
DEFINE_UI_TOOLTIP(Exposure, "Photographic exposure adjustment in stops. Plus one doubles scene-linear RGB.")
DEFINE_UI_TOOLTIP(Warmth, "Relative red-blue balance. This is not calibrated color temperature in Kelvin.")
DEFINE_UI_TOOLTIP(Tint, "Relative magenta-green balance. Zero is neutral.")
DEFINE_UI_TOOLTIP(Density R, "Red density points. Positive darkens. One point attenuates by 10 to the power of minus 0.025.")
DEFINE_UI_TOOLTIP(Density G, "Green density points. Positive darkens. One point attenuates by 10 to the power of minus 0.025.")
DEFINE_UI_TOOLTIP(Density B, "Blue density points. Positive darkens. One point attenuates by 10 to the power of minus 0.025.")
DEFINE_UI_TOOLTIP(Negative, "Enable the prototype negative response. Disable for numerical input and output checks.")
DEFINE_UI_TOOLTIP(Neg Crosstalk, "Density-dependent RGB interaction proxy. Not measured spectral dye behavior.")
DEFINE_UI_TOOLTIP(Show Look, "Neutral or provisional Yekermo Sew Fall and Winter interior looks. Creative approval is pending.")
DEFINE_UI_TOOLTIP(Skin Protect, "Reduces only the show-look contribution on chromatic skin candidates. Not semantic face detection.")
DEFINE_UI_TOOLTIP(Skin Width, "Hue half-width in degrees around Skin Hue or the enabled Skin Color swatch.")
DEFINE_UI_TOOLTIP(Print, "Enable the prototype print response. Disable for numerical input and output checks.")
DEFINE_UI_TOOLTIP(Vignette, "Edge attenuation in stops. Zero leaves the image unchanged. The visual guide shows its boundaries.")
DEFINE_UI_TOOLTIP(Vig Shape, "Zero follows the frame aspect ratio. One produces a circle in square-pixel image geometry.")
DEFINE_UI_TOOLTIP(Output Gray, "Encoded neutral 0.18 target with balance and creative stages bypassed. Default 0.42 is a design choice, not a universal gray standard.")
DEFINE_UI_TOOLTIP(Diagnostics, "Image-space diagnostic view. Use a terminal internal Rec709 path. Switch Off before export. A warning stripe is intentional.")
DEFINE_UI_TOOLTIP(Measure, "Source measures decoded RGB before balance. Balanced measures after exposure and balance but before the look.")
DEFINE_UI_TOOLTIP(Stage, "Stage inspected when Diagnostics is Stage View. Intermediate RGB is converted through the internal viewing transform.")
DEFINE_UI_TOOLTIP(Ref Gray, "Scene-linear reference for relative exposure. Default 0.18. Not a sensor clipping or noise-floor calibration.")
DEFINE_UI_TOOLTIP(EV Span, "Symmetric exposure scale in stops. Six means minus six through plus six.")
DEFINE_UI_TOOLTIP(Range Width, "Hue half-width in degrees. 180 selects the entire hue circle.")
DEFINE_UI_TOOLTIP(Range Luma Min, "Minimum encoded Rec709 Y-prime. The color mask uses HSV saturation and Y-prime, not scene exposure.")
DEFINE_UI_TOOLTIP(Neutral Limit, "Maximum HSV saturation for neutral candidates. A chromatic bias is not necessarily a white-balance error.")
DEFINE_UI_TOOLTIP(Range Color, "Display-encoded Rec709 RGB swatch. Only hue is used when Pick Range Hue is enabled. Choose a swatch in the color dialog. Raw or log viewer samples are not automatically converted.")
DEFINE_UI_TOOLTIP(Skin Color, "Display-encoded Rec709 RGB swatch. Only hue is used when Pick Skin Hue is enabled. It changes a color candidate, not face detection. Raw or log viewer samples need encoding verification.")
DEFINE_UI_TOOLTIP(Pick Range Hue, "Use Range Color hue instead of Range Hue. A neutral or invalid swatch falls back to Range Hue. Width, saturation and luma limits remain active.")
DEFINE_UI_TOOLTIP(Pick Skin Hue, "Use Skin Color hue instead of Skin Hue. A neutral or invalid swatch falls back to Skin Hue. Width and saturation limits remain active.")
DEFINE_UI_TOOLTIP(Visual Guide, "Read-only in-view guides driven by controls. Not draggable curves or an image histogram. Internal Rec709 only. Set Off before export; guides are rendered pixels.")
DEFINE_UI_TOOLTIP(Guide Opacity, "Opacity of the read-only visual guide. The top warning stripe remains visible regardless of this setting.")
DEFINE_UI_TOOLTIP(WB Method, "Legacy preserves the alpha.1 Warmth and Tint behavior. CAT02 uses WB Temp K and WB Duv. Off bypasses chromatic white balance while keeping exposure and RGB density trims.")
DEFINE_UI_TOOLTIP(WB Temp K, "Source illuminant CCT used by CAT02 white balance. The model blends Planckian and CIE daylight loci and adapts the selected source white to D65.")
DEFINE_UI_TOOLTIP(WB Duv, "Source-white offset in CIE 1960 UCS. Positive values move the assumed illuminant toward green before adaptation to D65.")
DEFINE_UI_TOOLTIP(WB Strength, "Mix between unadapted and CAT02-adapted scene-linear DWG. One applies the full adaptation.")
DEFINE_UI_TOOLTIP(Film Model, "Legacy preserves prior negative and print behavior. YS Advanced enables the M3 parametric density-separation and exposure-dependent color model.")
DEFINE_UI_TOOLTIP(Neg Density, "Neutral negative-density trim in base-10 density units. Positive darkens before the show look. This is parametric, not measured stock density.")
DEFINE_UI_TOOLTIP(Neg Color, "Master chroma scale for the advanced negative model.")
DEFINE_UI_TOOLTIP(Neg Sep, "Log-ratio color separation for positive RGB regions, blended safely back toward the legacy chroma basis near negative wide-gamut components.")
DEFINE_UI_TOOLTIP(Neg Shadow Sat, "Relative chroma retention in deep shadows for the advanced negative.")
DEFINE_UI_TOOLTIP(Neg High Sat, "Relative chroma retention in strong highlights for the advanced negative.")
DEFINE_UI_TOOLTIP(Neg Warm, "Hue-selective warm-family density bias. Zero is neutral.")
DEFINE_UI_TOOLTIP(Neg Green, "Hue-selective green-family density bias. Zero is neutral.")
DEFINE_UI_TOOLTIP(Neg Cool, "Hue-selective cyan-blue density bias. Zero is neutral.")
DEFINE_UI_TOOLTIP(Print Blacks, "Advanced print shadow-density trim in stops. Positive deepens shadows.")
DEFINE_UI_TOOLTIP(Print Whites, "Advanced print highlight-density trim in stops. Positive lifts upper values.")
DEFINE_UI_TOOLTIP(Print Sep, "Advanced print log-ratio color separation amount.")
DEFINE_UI_TOOLTIP(Print Warm, "Luminance-preserving warm print bias weighted toward the upper midtones and highlights.")
DEFINE_UI_TOOLTIP(Print Color, "Master print chroma scale before the display render.")
DEFINE_UI_TOOLTIP(Optics, "Enable M4 spatial sampling. Off preserves the M3 pointwise pipeline and avoids neighborhood texture reads.")
DEFINE_UI_TOOLTIP(Optics Quality, "Draft samples 4 directions, Standard 8 and High 16 at two radii. Higher quality substantially increases texture reads.")
DEFINE_UI_TOOLTIP(Optics Mix, "Master gain for all spatial optical contributions.")
DEFINE_UI_TOOLTIP(Soft x100, "Shared highlight feather in hundredths of a stop. 75 means 0.75 stop.")
DEFINE_UI_TOOLTIP(Hal Percent, "Halation amount in percent. 100 means unity contribution gain before Optics Mix.")
DEFINE_UI_TOOLTIP(Hal Radius, "Halation radius in reference pixels at 2160 image lines; scales with image height.")
DEFINE_UI_TOOLTIP(Hal EV x10, "Halation threshold in tenths of a stop relative to 18 percent gray. 20 means plus 2.0 stops.")
DEFINE_UI_TOOLTIP(Hal Tint, "Zero is redder and one moves the contribution toward orange.")
DEFINE_UI_TOOLTIP(Bloom Percent, "Bloom amount in percent. 100 means unity contribution gain before Optics Mix.")
DEFINE_UI_TOOLTIP(Bloom Radius, "Bloom radius in reference pixels at 2160 image lines.")
DEFINE_UI_TOOLTIP(Bloom EV x10, "Bloom threshold in tenths of a stop relative to 18 percent gray.")
DEFINE_UI_TOOLTIP(Glow Percent, "Glow amount in percent. 100 means unity contribution gain before Optics Mix.")
DEFINE_UI_TOOLTIP(Glow Radius, "Glow radius in reference pixels at 2160 image lines.")
DEFINE_UI_TOOLTIP(Glow EV x10, "Glow threshold in tenths of a stop relative to 18 percent gray.")
DEFINE_UI_TOOLTIP(Veil Percent, "Veiling-glare amount in percent. This remains a local finite-radius approximation.")
DEFINE_UI_TOOLTIP(Veil Radius, "Veiling-glare radius in reference pixels at 2160 image lines.")
DEFINE_UI_TOOLTIP(Veil EV x10, "Veiling-glare threshold in tenths of a stop relative to 18 percent gray.")
DEFINE_UI_TOOLTIP(Optics View, "Contribution view for M4 effects. Requires internal Rec709 output and uses Diag Gain for inspection.")
DEFINE_UI_TOOLTIP(Texture, "Enable M5 lens softness and film grain. Off preserves the M4 pipeline and skips texture processing.")
DEFINE_UI_TOOLTIP(Grain Gauge, "Base spatial grain-size preset. Gauge names are artistic scale presets, not measured stock scans.")
DEFINE_UI_TOOLTIP(Grain Percent, "Master grain density amplitude in percent. Grain is multiplicative in a density-style domain after print.")
DEFINE_UI_TOOLTIP(Grain Size x100, "Multiplier for the selected gauge grain size. 100 is the preset base size.")
DEFINE_UI_TOOLTIP(Grain Rough, "Blends single-scale grain toward a rougher three-scale texture.")
DEFINE_UI_TOOLTIP(Grain Color, "Blend from correlated monochrome grain toward independent RGB layer grain.")
DEFINE_UI_TOOLTIP(Grain Shadow, "Relative grain amplitude in deep shadows, percent.")
DEFINE_UI_TOOLTIP(Grain Mid, "Relative grain amplitude around middle exposure, percent.")
DEFINE_UI_TOOLTIP(Grain High, "Relative grain amplitude in strong highlights, percent.")
DEFINE_UI_TOOLTIP(Grain Motion, "Static or timeline-frame deterministic cadence using TIMELINE_FRAME_INDEX and RAND.")
DEFINE_UI_TOOLTIP(Grain Seed, "Deterministic spatial and temporal grain seed.")
DEFINE_UI_TOOLTIP(Lens Soft, "Broadband local RGB softness before the negative, percent.")
DEFINE_UI_TOOLTIP(Lens Radius, "Lens-softness radius in reference pixels at 2160 image lines.")
DEFINE_UI_TOOLTIP(Micro Soft, "Reduces local luminance microcontrast while retaining more chroma, percent.")
DEFINE_UI_TOOLTIP(Texture View, "M5 diagnostic for signed grain, exposure weight, lens-softness difference, or combined contribution. Internal Rec709 only.")
DEFINE_UI_TOOLTIP(Diag Gamut, "Destination-gamut target for M6 diagnostics only. This does not change normal output or add a P3/2020 delivery transform.")
DEFINE_UI_TOOLTIP(Gamut Margin x1k, "Near-boundary margin in target linear RGB. 20 means 0.020 from a cube face.")
DEFINE_UI_TOOLTIP(Cal Profile, "Scene reference used by M6 calibration diagnostics: 18 percent gray, 90 percent diffuse white, 2 percent black, or Custom.")
DEFINE_UI_TOOLTIP(Cal Target x1k, "Custom scene-linear luminance reference. 180 means 0.180. Used only when Cal Profile is Custom.")
DEFINE_UI_TOOLTIP(Cal Tol x100, "Exposure tolerance in hundredths of a stop. 15 means plus or minus 0.15 stop.")
DEFINE_UI_TOOLTIP(Cal Neutral x1k, "D65 xy chromaticity-distance tolerance in thousandths. 10 means 0.010 xy distance.")

// Pure helpers: never refer to UI variables outside transform().
__DEVICE__ float ys_clamp(float x, float a, float b) { return _fminf(_fmaxf(x, a), b); }
__DEVICE__ float ys_sat(float x) { return ys_clamp(x, 0.0f, 1.0f); }
__DEVICE__ float3 ys_gray(float x) { return make_float3(x, x, x); }
__DEVICE__ float3 ys_scale(float3 a, float k) { return make_float3(a.x*k, a.y*k, a.z*k); }
__DEVICE__ float3 ys_mix(float3 a, float3 b, float t) {
    return make_float3(a.x+(b.x-a.x)*t, a.y+(b.y-a.y)*t, a.z+(b.z-a.z)*t);
}
__DEVICE__ float3 ys_clip(float3 v) { return make_float3(ys_sat(v.x), ys_sat(v.y), ys_sat(v.z)); }
__DEVICE__ float ys_max(float3 v) { return _fmaxf(v.x, _fmaxf(v.y, v.z)); }
__DEVICE__ float ys_min(float3 v) { return _fminf(v.x, _fminf(v.y, v.z)); }
__DEVICE__ float ys_smooth(float a, float b, float x) {
    if (b <= a) return x >= a ? 1.0f : 0.0f;
    float t = ys_sat((x-a)/(b-a)); return t*t*(3.0f-2.0f*t);
}
__DEVICE__ float ys_band(float x, float a, float b, float feather) {
    float lo = _fminf(a,b), hi = _fmaxf(a,b);
    if (feather <= 0.0f) return x >= lo && x <= hi ? 1.0f : 0.0f;
    return ys_smooth(lo-feather, lo, x) * (1.0f-ys_smooth(hi,hi+feather,x));
}
__DEVICE__ int ys_finite(float x) { return x == x && _fabs(x) <= 3.4028234e38f; }
__DEVICE__ int ys_safe(float3 v) {
    return ys_finite(v.x) && ys_finite(v.y) && ys_finite(v.z) &&
        _fabs(v.x) <= 1.0e6f && _fabs(v.y) <= 1.0e6f && _fabs(v.z) <= 1.0e6f;
}
__DEVICE__ float ys_Y(float3 v) { return 0.27411851f*v.x + 0.87363190f*v.y - 0.14775041f*v.z; }
__DEVICE__ float ys_Y709(float3 v) { return 0.212639006f*v.x + 0.715168679f*v.y + 0.072192315f*v.z; }
__DEVICE__ float ys_yprime(float3 v) { return 0.2126f*v.x + 0.7152f*v.y + 0.0722f*v.z; }

// Blackmagic DWG/DI specification, April 2021, pp. 3-4. Negative linear branch retained.
__DEVICE__ float ys_di_decode(float v) {
    if (v <= 0.02740668f) return v / 10.44426855f;
    return _exp2f(v / 0.07329248f - 7.0f) - 0.0075f;
}
__DEVICE__ float ys_di_encode(float v) {
    if (v <= 0.00262409f) return v * 10.44426855f;
    return (_log2f(v + 0.0075f) + 7.0f) * 0.07329248f;
}
__DEVICE__ float3 ys_dwg_xyz(float3 v) {
    return make_float3(0.70062239f*v.x+0.14877482f*v.y+0.10105872f*v.z,
        ys_Y(v), -0.09896291f*v.x-0.13789533f*v.y+1.32591599f*v.z);
}
__DEVICE__ float3 ys_xyz_dwg(float3 v) {
    return make_float3(1.51667204f*v.x-0.28147805f*v.y-0.14696363f*v.z,
        -0.46491710f*v.x+1.25142378f*v.y+0.17488461f*v.z,
        0.06484905f*v.x+0.10913934f*v.y+0.76141462f*v.z);
}
// Matrices derived from BT.709 primaries and D65, not a camera IDT.
__DEVICE__ float3 ys_xyz_709(float3 v) {
    return make_float3(3.240969942f*v.x-1.537383178f*v.y-0.498610760f*v.z,
        -0.969243636f*v.x+1.875967502f*v.y+0.041555057f*v.z,
        0.055630080f*v.x-0.203976959f*v.y+1.056971514f*v.z);
}
__DEVICE__ float3 ys_709_xyz(float3 v) {
    return make_float3(0.412390799f*v.x+0.357584339f*v.y+0.180480788f*v.z,
        ys_Y709(v), 0.019330819f*v.x+0.119194780f*v.y+0.950532152f*v.z);
}
__DEVICE__ float3 ys_to709(float3 v) { return ys_xyz_709(ys_dwg_xyz(v)); }
__DEVICE__ float3 ys_from709(float3 v) { return ys_xyz_dwg(ys_709_xyz(v)); }


// M6 destination-gamut diagnostics. Matrices are D65 linear RGB transforms derived
// from standardized P3-D65 and Rec.2020 primaries. These do not create new delivery outputs.
__DEVICE__ float3 ys_xyz_p3d65(float3 v) {
    return make_float3(
         2.493496911941425f*v.x - 0.931383617919124f*v.y - 0.402710784450717f*v.z,
        -0.829488969561575f*v.x + 1.762664060318346f*v.y + 0.023624685841944f*v.z,
         0.035845830243784f*v.x - 0.076172389268041f*v.y + 0.956884524007687f*v.z);
}
__DEVICE__ float3 ys_xyz_2020(float3 v) {
    return make_float3(
         1.716651187971268f*v.x - 0.355670783776392f*v.y - 0.253366281373660f*v.z,
        -0.666684351832489f*v.x + 1.616481236634939f*v.y + 0.015768545813911f*v.z,
         0.017639857445311f*v.x - 0.042770613257809f*v.y + 0.942103121235474f*v.z);
}
__DEVICE__ float3 ys_target_rgb(float3 dwg,int target_kind) {
    float3 xyz=ys_dwg_xyz(dwg);
    if (target_kind == 1) return ys_xyz_p3d65(xyz);
    if (target_kind == 2) return ys_xyz_2020(xyz);
    return ys_xyz_709(xyz);
}
__DEVICE__ float ys_target_y(float3 rgb,int target_kind) {
    if (target_kind == 1) return 0.228974564069749f*rgb.x + 0.691738521836506f*rgb.y + 0.079286914093745f*rgb.z;
    if (target_kind == 2) return 0.262700212011267f*rgb.x + 0.677998071518871f*rgb.y + 0.059301716469862f*rgb.z;
    return ys_Y709(rgb);
}
__DEVICE__ float ys_target_occupancy(float3 rgb,int target_kind) {
    float y=ys_clamp(ys_target_y(rgb,target_kind),0.0f,1.0f);
    float up=_fmaxf(1.0f-y,1.0e-8f), down=_fmaxf(y,1.0e-8f);
    return _fmaxf((ys_max(rgb)-y)/up,(y-ys_min(rgb))/down);
}
__DEVICE__ float ys_target_headroom(float3 rgb) {
    float low=ys_min(rgb), high=1.0f-ys_max(rgb);
    return _fminf(low,high);
}
__DEVICE__ float3 ys_target_status(float3 rgb,float margin) {
    float h=ys_target_headroom(rgb);
    if (h < 0.0f) return make_float3(1.0f,0.05f,0.10f);
    if (h < margin) return make_float3(1.0f,0.75f,0.0f);
    return make_float3(0.10f,0.65f,0.20f);
}
__DEVICE__ float ys_cal_target_value(int profile_kind,int custom_x1000) {
    if (profile_kind == 0) return 0.18f;
    if (profile_kind == 1) return 0.90f;
    if (profile_kind == 2) return 0.02f;
    return _fmaxf((float)custom_x1000*0.001f,0.001f);
}
__DEVICE__ float ys_neutral_xy_error(float3 scene) {
    float3 xyz=ys_dwg_xyz(scene);
    float sum=xyz.x+xyz.y+xyz.z;
    if (sum <= 1.0e-12f) return 1.0f;
    float x=xyz.x/sum, y=xyz.y/sum;
    float dx=x-0.3127f, dy=y-0.3290f;
    return _sqrtf(dx*dx+dy*dy);
}
__DEVICE__ float3 ys_cal_ev_color(float err,float tol) {
    float a=_fabs(err);
    if (a <= tol) return make_float3(0.10f,0.75f,0.20f);
    float t=ys_sat((a-tol)/_fmaxf(4.0f*tol,0.05f));
    if (err < 0.0f) return ys_mix(make_float3(0.0f,0.55f,0.95f),make_float3(0.05f,0.10f,0.80f),t);
    return ys_mix(make_float3(1.0f,0.75f,0.0f),make_float3(0.95f,0.05f,0.15f),t);
}
__DEVICE__ float3 ys_cal_neutral_color(float err,float tol) {
    if (err <= tol) return make_float3(0.10f,0.75f,0.20f);
    if (err <= 2.0f*tol) return make_float3(1.0f,0.75f,0.0f);
    return make_float3(0.95f,0.05f,0.15f);
}


// M2 camera input transforms. Each published camera gamut is converted through CIE XYZ D65
// into scene-linear DaVinci Wide Gamut. These are technical decoders, not RAW debayering.
__DEVICE__ float ys_logc4_decode(float v) {
    const float a = 2231.8263090676883f;
    const float b = 0.9071358748778103f;
    const float c = 0.09286412512218964f;
    const float s = 0.1135972086105891f;
    const float t = -0.01805699611991131f;
    if (v < 0.0f) return v*s+t;
    return (_exp2f(14.0f*(v-c)/b+6.0f)-64.0f)/a;
}
__DEVICE__ float ys_logc4_encode(float v) {
    const float a = 2231.8263090676883f;
    const float b = 0.9071358748778103f;
    const float c = 0.09286412512218964f;
    const float s = 0.1135972086105891f;
    const float t = -0.01805699611991131f;
    if (v < t) return (v-t)/s;
    return (_log2f(a*v+64.0f)-6.0f)/14.0f*b+c;
}
__DEVICE__ float3 ys_awg4_xyz(float3 v) {
    return make_float3(
        0.704858320407232064f*v.x + 0.129760295170463003f*v.y + 0.115837311473976537f*v.z,
        0.254524176404027025f*v.x + 0.781477732712002049f*v.y - 0.036001909116029039f*v.z,
        1.089057750759878429f*v.z);
}
__DEVICE__ float ys_slog3_decode(float v) {
    const float cut = 171.2102946929f/1023.0f;
    if (v >= cut) return _powf(10.0f,(v*1023.0f-420.0f)/261.5f)*0.19f-0.01f;
    return (v*1023.0f-95.0f)*0.01125f/(171.2102946929f-95.0f);
}
__DEVICE__ float ys_slog3_encode(float v) {
    if (v >= 0.01125f)
        return (420.0f + (_log2f((v+0.01f)/0.19f)*0.3010299956639812f)*261.5f)/1023.0f;
    return (v*(171.2102946929f-95.0f)/0.01125f+95.0f)/1023.0f;
}
// Matrices below are derived from Sony's published CIE xy primaries and D65 white.
__DEVICE__ float3 ys_sgamut3cine_xyz(float3 v) {
    return make_float3(
        0.599083920758672f*v.x + 0.248925516115147f*v.y + 0.102446490178174f*v.z,
        0.215075820116077f*v.x + 0.885068501744598f*v.y - 0.100144321860675f*v.z,
       -0.032065849545822f*v.x - 0.027658390679458f*v.y + 1.148781990204675f*v.z);
}
__DEVICE__ float3 ys_sgamut3_xyz(float3 v) {
    return make_float3(
        0.706482713192173f*v.x + 0.128801049791290f*v.y + 0.115172164759678f*v.z,
        0.270979670813193f*v.x + 0.786606411201264f*v.y - 0.057586082014457f*v.z,
       -0.009677845386151f*v.x + 0.004600037492436f*v.y + 1.094135555285109f*v.z);
}
__DEVICE__ float ys_log3g10_decode(float v) {
    const float a=0.224282f,b=155.975327f,c=0.01f,g=15.1927f;
    if (v < 0.0f) return v/g-c;
    return (_powf(10.0f,v/a)-1.0f)/b-c;
}
__DEVICE__ float ys_log3g10_encode(float v) {
    const float a=0.224282f,b=155.975327f,c=0.01f,g=15.1927f;
    float x=v+c;
    if (x < 0.0f) return x*g;
    return a*(_log2f(x*b+1.0f)*0.3010299956639812f);
}
__DEVICE__ float3 ys_rwg_xyz(float3 v) {
    return make_float3(
        0.735275f*v.x + 0.068609f*v.y + 0.146571f*v.z,
        0.286694f*v.x + 0.842979f*v.y - 0.129673f*v.z,
       -0.079681f*v.x - 0.347343f*v.y + 1.516081f*v.z);
}
__DEVICE__ float3 ys_planck_xy(float temp) {
    float T=ys_clamp(temp,1667.0f,25000.0f);
    float i=1.0f/T,i2=i*i,i3=i2*i;
    float x=T<=4000.0f ? -0.2661239e9f*i3-0.2343580e6f*i2+0.8776956e3f*i+0.179910f
                       : -3.0258469e9f*i3+2.1070379e6f*i2+0.2226347e3f*i+0.240390f;
    float y;
    if (T<=2222.0f) y=-1.1063814f*x*x*x-1.34811020f*x*x+2.18555832f*x-0.20219683f;
    else if (T<=4000.0f) y=-0.9549476f*x*x*x-1.37418593f*x*x+2.09137015f*x-0.16748867f;
    else y=3.0817580f*x*x*x-5.87338670f*x*x+3.75112997f*x-0.37001483f;
    return make_float3(x,y,0.0f);
}
__DEVICE__ float3 ys_daylight_xy(float temp) {
    float T=ys_clamp(temp,4000.0f,25000.0f),q=1000.0f/T,q2=q*q,q3=q2*q;
    float x=T<=7000.0f ? 0.244063f+0.09911f*q+2.9678f*q2-4.6070f*q3
                       : 0.237040f+0.24748f*q+1.9018f*q2-2.0064f*q3;
    return make_float3(x,-3.0f*x*x+2.87f*x-0.275f,0.0f);
}
__DEVICE__ float3 ys_cct_xy(float temp) {
    float T=ys_clamp(temp,1667.0f,25000.0f);
    if (T<=3500.0f) return ys_planck_xy(T);
    if (T>=4500.0f) return ys_daylight_xy(T);
    return ys_mix(ys_planck_xy(T),ys_daylight_xy(T),ys_smooth(3500.0f,4500.0f,T));
}
__DEVICE__ float3 ys_xy_uv1960(float3 xy) {
    float den=-2.0f*xy.x+12.0f*xy.y+3.0f;
    return make_float3(4.0f*xy.x/den,6.0f*xy.y/den,0.0f);
}
__DEVICE__ float3 ys_uv1960_xy(float3 uv) {
    float den=2.0f*uv.x-8.0f*uv.y+4.0f;
    return make_float3(3.0f*uv.x/den,2.0f*uv.y/den,0.0f);
}
__DEVICE__ float3 ys_source_white_xy(float temp,float duv) {
    float T=ys_clamp(temp,1667.0f,25000.0f);
    if (_fabs(T-6504.0f)<0.5f && _fabs(duv)<1.0e-8f) return make_float3(0.3127f,0.3290f,0.0f);
    float3 uv=ys_xy_uv1960(ys_cct_xy(T));
    float lo=_fmaxf(1667.0f,T-25.0f),hi=_fminf(25000.0f,T+25.0f);
    float3 u0=ys_xy_uv1960(ys_cct_xy(lo)),u1=ys_xy_uv1960(ys_cct_xy(hi));
    float tu=u1.x-u0.x,tv=u1.y-u0.y,norm=_sqrtf(tu*tu+tv*tv);
    if (norm>1.0e-10f) {
        float nu=tv/norm,nv=-tu/norm;
        if (nv<0.0f) { nu=-nu; nv=-nv; }
        uv.x+=duv*nu; uv.y+=duv*nv;
    }
    return ys_uv1960_xy(uv);
}
__DEVICE__ float3 ys_xy_xyz(float3 xy) {
    float y=_fmaxf(xy.y,1.0e-8f);
    return make_float3(xy.x/y,1.0f,(1.0f-xy.x-xy.y)/y);
}
__DEVICE__ float3 ys_cat02_lms(float3 v) {
    return make_float3(0.7328f*v.x+0.4296f*v.y-0.1624f*v.z,
        -0.7036f*v.x+1.6975f*v.y+0.0061f*v.z,0.0030f*v.x+0.0136f*v.y+0.9834f*v.z);
}
__DEVICE__ float3 ys_cat02_xyz(float3 v) {
    return make_float3(1.096123820835514f*v.x-0.278869000218287f*v.y+0.182745179382773f*v.z,
        0.454369041975359f*v.x+0.473533154307412f*v.y+0.072097803721230f*v.z,
        -0.009627608738429f*v.x-0.005698031216113f*v.y+1.015325639954543f*v.z);
}
__DEVICE__ float3 ys_cat02_wb(float3 scene,float temp,float duv) {
    float3 src=ys_xy_xyz(ys_source_white_xy(temp,duv));
    float3 dst=make_float3(0.950455927051672f,1.0f,1.089057750759878f);
    float3 sl=ys_cat02_lms(src),dl=ys_cat02_lms(dst);
    float3 lms=ys_cat02_lms(ys_dwg_xyz(scene));
    lms=make_float3(lms.x*dl.x/sl.x,lms.y*dl.y/sl.y,lms.z*dl.z/sl.z);
    return ys_xyz_dwg(ys_cat02_xyz(lms));
}
__DEVICE__ float3 ys_input(float3 v, int mode) {
    if (mode==0) return make_float3(ys_di_decode(v.x),ys_di_decode(v.y),ys_di_decode(v.z));
    if (mode==1) return v;
    if (mode==2) return ys_from709(v);
    if (mode==3) {
        float3 q=make_float3(ys_logc4_decode(v.x),ys_logc4_decode(v.y),ys_logc4_decode(v.z));
        return ys_xyz_dwg(ys_awg4_xyz(q));
    }
    if (mode==4) {
        float3 q=make_float3(ys_slog3_decode(v.x),ys_slog3_decode(v.y),ys_slog3_decode(v.z));
        return ys_xyz_dwg(ys_sgamut3cine_xyz(q));
    }
    if (mode==5) {
        float3 q=make_float3(ys_slog3_decode(v.x),ys_slog3_decode(v.y),ys_slog3_decode(v.z));
        return ys_xyz_dwg(ys_sgamut3_xyz(q));
    }
    if (mode==6) {
        float3 q=make_float3(ys_log3g10_decode(v.x),ys_log3g10_decode(v.y),ys_log3g10_decode(v.z));
        return ys_xyz_dwg(ys_rwg_xyz(q));
    }
    return v;
}
__DEVICE__ float3 ys_encode_working(float3 v, int mode) {
    if (mode == 0) return make_float3(ys_di_encode(v.x),ys_di_encode(v.y),ys_di_encode(v.z));
    return v;
}
__DEVICE__ float ys_stops(float y, float gray) {
    // Nonpositive luminance is not a measurable finite exposure. Caller marks it.
    return y > 0.0f ? _log2f(_fmaxf(y,1.0e-30f)/gray) : -100.0f;
}
__DEVICE__ float ys_softplus(float x) {
    if (x > 20.0f) return x;
    if (x < -20.0f) return _exp2f(x)*1.442695041f;
    return _log2f(1.0f+_exp2f(x));
}
__DEVICE__ float3 ys_curve(float3 v, float contrast, float toe, float shoulder) {
    float y = ys_Y(v);
    if (y <= 1.0e-20f) return v;
    float s = ys_stops(y,0.18f);
    float anchor = ys_softplus(-2.0f);
    float t = contrast*s + toe*(ys_softplus(-s-2.0f)-anchor)
        - shoulder*(ys_softplus(s-2.0f)-anchor);
    return ys_scale(v,_exp2f(ys_clamp(t-s,-30.0f,30.0f)));
}
__DEVICE__ float3 ys_saturation(float3 v, float amount) { return ys_mix(ys_gray(ys_Y(v)),v,amount); }
__DEVICE__ float3 ys_interaction(float3 v, float amount) {
    float y = ys_Y(v);
    float c = amount*(1.0f-ys_smooth(1.0f,6.0f,ys_stops(y,0.18f)));
    float3 r = make_float3((1.0f-c)*v.x+c*(0.6f*v.y+0.4f*v.z),
        (1.0f-c)*v.y+c*(0.5f*v.x+0.5f*v.z), (1.0f-c)*v.z+c*(0.4f*v.x+0.6f*v.y));
    float yr = ys_Y(r);
    if (y > 1.0e-8f && yr > 1.0e-8f) r = ys_scale(r,y/yr);
    return r;
}
__DEVICE__ float3 ys_balance(float3 v,float ev,float w,float t,float r,float g,float b) {
    // Relative RGB balance, NOT Kelvin/chromatic adaptation. A density point = 0.025 log10.
    return make_float3(v.x*_exp2f(ev+0.35f*w+0.175f*t-0.083048202f*r),
        v.y*_exp2f(ev-0.35f*t-0.083048202f*g),
        v.z*_exp2f(ev-0.35f*w+0.175f*t-0.083048202f*b));
}

__DEVICE__ float3 ys_balance_m2(float3 v,float ev,float w,float t,float r,float g,float b,
    int method,float temp,float duv,float strength) {
    if (method==0) return ys_balance(v,ev,w,t,r,g,b);
    float3 base=v;
    if (method==1) base=ys_mix(v,ys_cat02_wb(v,temp,duv),ys_sat(strength));
    return ys_balance(base,ev,0.0f,0.0f,r,g,b);
}

// Original analytic SDR renderer. Not ACES, a Resolve DRT clone, or BT.709 camera OETF.
__DEVICE__ float ys_tone(float y,float gray_code) {
    float target = _powf(gray_code,2.4f);
    float k = 0.18f*(1.0f-target)/target;
    return y > 0.0f ? y/(y+k) : 0.0f;
}

__DEVICE__ float3 ys_target_pre(float3 dwg,int target_kind,float gray_code) {
    float3 rgb=ys_target_rgb(dwg,target_kind);
    float y=ys_target_y(rgb,target_kind);
    if (y <= 1.0e-20f) return ys_gray(0.0f);
    return ys_scale(rgb,ys_tone(y,gray_code)/y);
}
__DEVICE__ float3 ys_pre_gamut(float3 v,float gray_code) {
    float3 r = ys_to709(v); float y = ys_Y709(r);
    if (y <= 1.0e-20f) return ys_gray(0.0f);
    return ys_scale(r,ys_tone(y,gray_code)/y);
}
__DEVICE__ float ys_gamut_factor(float3 v,float knee) {
    float y = ys_sat(ys_Y709(v));
    float up = _fmaxf(1.0f-y,1.0e-8f), down = _fmaxf(y,1.0e-8f);
    float e = _fmaxf((ys_max(v)-y)/up,(y-ys_min(v))/down);
    if (e <= knee) return 1.0f;
    float mapped = knee+(1.0f-knee)*(1.0f-_expf(-(e-knee)/(1.0f-knee)));
    return ys_sat(mapped/_fmaxf(e,1.0e-8f));
}
__DEVICE__ float3 ys_gamut(float3 v,float factor) { return ys_mix(ys_gray(ys_Y709(v)),v,factor); }
__DEVICE__ float3 ys_gamma24(float3 v) {
    v = ys_clip(v); return make_float3(_powf(v.x,1.0f/2.4f),_powf(v.y,1.0f/2.4f),_powf(v.z,1.0f/2.4f));
}
__DEVICE__ float3 ys_view(float3 v,float gray_code,int compress,float knee) {
    float3 p = ys_pre_gamut(v,gray_code);
    return ys_gamma24(compress ? ys_gamut(p,ys_gamut_factor(p,knee)) : p);
}
__DEVICE__ float3 ys_hsv(float3 v) {
    float mx = ys_max(v), mn = ys_min(v), d = mx-mn;
    float h = 0.0f;
    if (d > 1.0e-7f) {
        if (mx == v.x) h = 60.0f*(v.y-v.z)/d;
        else if (mx == v.y) h = 120.0f+60.0f*(v.z-v.x)/d;
        else h = 240.0f+60.0f*(v.x-v.y)/d;
        if (h < 0.0f) h += 360.0f;
    }
    return make_float3(h,mx > 1.0e-8f ? d/mx : 0.0f,mx);
}
__DEVICE__ float ys_hue_weight(float h,float center,float width,float feather) {
    float d = _fabs(h-center); d = _fminf(d,360.0f-d);
    if (width >= 180.0f) return 1.0f;
    if (feather <= 0.0f) return d <= width ? 1.0f : 0.0f;
    return 1.0f-ys_smooth(width,_fminf(width+feather,180.0f),d);
}
__DEVICE__ float ys_skin(float3 scene,float center,float width,float smin,float smax) {
    // Fixed neutral viewing transform; independent of the creative look and output gray.
    float3 hsv = ys_hsv(ys_view(scene,0.42f,1,0.8f));
    if (hsv.y < 1.0e-6f) return 0.0f;
    return ys_hue_weight(hsv.x,center,width,8.0f)*ys_band(hsv.y,smin,smax,0.03f);
}
__DEVICE__ float3 ys_show(float3 v,int mode,float amount,float protect,float skin) {
    if (mode == 0 || amount <= 0.0f) return v;
    float s = ys_stops(ys_Y(v),0.18f);
    float sh = 1.0f-ys_smooth(-2.0f,1.0f,s), hi = ys_smooth(0.0f,4.0f,s);
    float rr = -0.035f*sh+0.04f*hi, gg = 0.0f, bb = 0.055f*sh-0.025f*hi;
    float sat = 0.94f;
    if (mode == 2) { rr = -0.08f*sh+0.025f*hi; gg = 0.008f*sh; bb = 0.12f*sh; sat = 0.90f; }
    float3 out = make_float3(v.x*_exp2f(rr),v.y*_exp2f(gg),v.z*_exp2f(bb));
    float oy = ys_Y(out), iy = ys_Y(v);
    if (oy > 1.0e-8f && iy > 1.0e-8f) out = ys_scale(out,iy/oy);
    out = ys_saturation(out,sat);
    return ys_mix(v,out,amount*(1.0f-protect*skin));
}


__DEVICE__ float3 ys_preserve_y(float3 v,float target_y) {
    float y=ys_Y(v);
    if (target_y > 1.0e-8f && y > 1.0e-8f) return ys_scale(v,target_y/y);
    return v;
}
__DEVICE__ float3 ys_density_separation(float3 v,float amount) {
    float y=ys_Y(v);
    if (amount <= 0.0f || y <= 1.0e-8f) return v;
    float floorv=_fmaxf(y*1.0e-5f,1.0e-12f);
    float positivity=ys_smooth(-0.02f*y,0.05f*y,ys_min(v));
    if (positivity <= 0.0f) return v;
    float lr=_log2f(_fmaxf(v.x,floorv)/y);
    float lg=_log2f(_fmaxf(v.y,floorv)/y);
    float lb=_log2f(_fmaxf(v.z,floorv)/y);
    float k=amount*positivity;
    float nr=lr+k*(0.55f*lr-0.30f*lg-0.25f*lb);
    float ng=lg+k*(-0.22f*lr+0.46f*lg-0.24f*lb);
    float nb=lb+k*(-0.20f*lr-0.28f*lg+0.48f*lb);
    float3 out=make_float3(y*_exp2f(nr),y*_exp2f(ng),y*_exp2f(nb));
    out=ys_preserve_y(out,y);
    return ys_mix(v,out,positivity);
}
__DEVICE__ float3 ys_exposure_chroma(float3 v,float master,float shadow_keep,float high_keep) {
    float y=ys_Y(v);
    if (y <= 1.0e-8f) return v;
    float ev=ys_stops(y,0.18f);
    float sh=1.0f-ys_smooth(-3.5f,-0.25f,ev);
    float hi=ys_smooth(0.75f,5.0f,ev);
    float retention=master*(1.0f-sh*(1.0f-shadow_keep))*(1.0f-hi*(1.0f-high_keep));
    return ys_saturation(v,_fmaxf(retention,0.0f));
}
__DEVICE__ float3 ys_hue_density_bias(float3 v,float warm_bias,float green,float cool) {
    float y=ys_Y(v);
    if (y <= 1.0e-8f || (_fabs(warm_bias)+_fabs(green)+_fabs(cool)) <= 1.0e-8f) return v;
    float3 hsv=ys_hsv(ys_view(v,0.42f,1,0.8f));
    if (hsv.y <= 1.0e-5f) return v;
    float ww=ys_hue_weight(hsv.x,28.0f,62.0f,18.0f);
    float gw=ys_hue_weight(hsv.x,125.0f,42.0f,18.0f);
    float cw=ys_hue_weight(hsv.x,228.0f,68.0f,20.0f);
    float rr=0.11f*warm_bias*ww-0.035f*green*gw-0.045f*cool*cw;
    float gg=0.025f*warm_bias*ww+0.085f*green*gw-0.020f*cool*cw;
    float bb=-0.090f*warm_bias*ww-0.040f*green*gw+0.105f*cool*cw;
    float3 out=make_float3(v.x*_exp2f(rr),v.y*_exp2f(gg),v.z*_exp2f(bb));
    return ys_preserve_y(out,y);
}
__DEVICE__ float3 ys_advanced_negative(float3 v,float contrast,float toe,float shoulder,float base_sat,float cross,
    float density,float color,float separation,float shadow_keep,float high_keep,float warm_bias,float green,float cool) {
    float3 out=ys_curve(v,contrast,toe,shoulder);
    out=ys_scale(out,_powf(10.0f,-density));
    out=ys_interaction(out,cross);
    out=ys_density_separation(out,separation);
    out=ys_exposure_chroma(out,base_sat*color,shadow_keep,high_keep);
    out=ys_hue_density_bias(out,warm_bias,green,cool);
    return out;
}
__DEVICE__ float3 ys_advanced_print(float3 v,float contrast,float toe,float shoulder,float density,float base_sat,
    float black_trim,float white_trim,float separation,float warm_bias,float color) {
    float3 out=ys_curve(v,contrast,toe,shoulder);
    float y=ys_Y(out);
    if (y > 1.0e-8f) {
        float ev=ys_stops(y,0.18f);
        float sh=1.0f-ys_smooth(-3.5f,-0.25f,ev);
        float hi=ys_smooth(0.5f,4.5f,ev);
        out=ys_scale(out,_exp2f(-black_trim*sh+white_trim*hi));
    }
    out=ys_scale(out,_powf(10.0f,-density));
    out=ys_density_separation(out,separation);
    out=ys_saturation(out,base_sat*color);
    float yy=ys_Y(out);
    if (yy > 1.0e-8f && _fabs(warm_bias) > 1.0e-8f) {
        float ev=ys_stops(yy,0.18f);
        float weight=0.25f+0.75f*ys_smooth(-0.5f,3.5f,ev);
        float3 biased=make_float3(out.x*_exp2f(0.070f*warm_bias*weight),
                                  out.y*_exp2f(0.018f*warm_bias*weight),
                                  out.z*_exp2f(-0.075f*warm_bias*weight));
        out=ys_preserve_y(biased,yy);
    }
    return out;
}


typedef struct {
    int enc;
    float ev_adj; float warm_adj; float tint_adj; float dens_r; float dens_g; float dens_b;
    int wb_kind; float wb_kelvin; float wb_offset; float wb_mix;
} YSSpatialParams;
__DEVICE__ int ys_boundi(int v,int lo,int hi) { return v < lo ? lo : (v > hi ? hi : v); }
__DEVICE__ float3 ys_tex_raw(__TEXTURE__ tex_r,__TEXTURE__ tex_g,__TEXTURE__ tex_b,
    int w,int h,int x,int y) {
    int xx=ys_boundi(x,0,w-1), yy=ys_boundi(y,0,h-1);
    return make_float3(_tex2D(tex_r,xx,yy),_tex2D(tex_g,xx,yy),_tex2D(tex_b,xx,yy));
}
__DEVICE__ float3 ys_sample_balanced(__TEXTURE__ tex_r,__TEXTURE__ tex_g,__TEXTURE__ tex_b,
    int w,int h,int x,int y,YSSpatialParams p) {
    float3 raw=ys_tex_raw(tex_r,tex_g,tex_b,w,h,x,y);
    float3 scene=ys_input(raw,p.enc);
    return ys_balance_m2(scene,p.ev_adj,p.warm_adj,p.tint_adj,p.dens_r,p.dens_g,p.dens_b,
        p.wb_kind,p.wb_kelvin,p.wb_offset,p.wb_mix);
}
__DEVICE__ float3 ys_pos3(float3 v) {
    return make_float3(_fmaxf(v.x,0.0f),_fmaxf(v.y,0.0f),_fmaxf(v.z,0.0f));
}
__DEVICE__ float3 ys_add3(float3 a,float3 b) {
    return make_float3(a.x+b.x,a.y+b.y,a.z+b.z);
}
__DEVICE__ float3 ys_sub_pos(float3 a,float3 b) {
    return make_float3(_fmaxf(a.x-b.x,0.0f),_fmaxf(a.y-b.y,0.0f),_fmaxf(a.z-b.z,0.0f));
}
__DEVICE__ float ys_highlight_weight(float3 v,float threshold_ev,float softness) {
    float y=ys_Y(v);
    if (y <= 1.0e-12f) return 0.0f;
    return ys_smooth(threshold_ev-softness,threshold_ev+softness,ys_stops(y,0.18f));
}
__DEVICE__ float3 ys_highlight_color(float3 v,float threshold_ev,float softness) {
    return ys_scale(ys_pos3(v),ys_highlight_weight(v,threshold_ev,softness));
}
__DEVICE__ float3 ys_highlight_at(__TEXTURE__ tex_r,__TEXTURE__ tex_g,__TEXTURE__ tex_b,
    int w,int h,int x,int y,YSSpatialParams p,float threshold_ev,float softness) {
    return ys_highlight_color(ys_sample_balanced(tex_r,tex_g,tex_b,w,h,x,y,p),threshold_ev,softness);
}
__DEVICE__ float3 ys_ring_source(__TEXTURE__ tex_r,__TEXTURE__ tex_g,__TEXTURE__ tex_b,
    int w,int h,int x,int y,YSSpatialParams p,int radius,int quality,float threshold_ev,float softness) {
    int r=radius < 1 ? 1 : radius;
    int d=(int)((float)r*0.70710678f+0.5f);
    int a=(int)((float)r*0.92387953f+0.5f);
    int b=(int)((float)r*0.38268343f+0.5f);
    float3 sum=make_float3(0.0f,0.0f,0.0f);
    sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x+r,y,p,threshold_ev,softness));
    sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x-r,y,p,threshold_ev,softness));
    sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x,y+r,p,threshold_ev,softness));
    sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x,y-r,p,threshold_ev,softness));
    int count=4;
    if (quality >= 1) {
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x+d,y+d,p,threshold_ev,softness));
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x-d,y+d,p,threshold_ev,softness));
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x+d,y-d,p,threshold_ev,softness));
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x-d,y-d,p,threshold_ev,softness));
        count=8;
    }
    if (quality >= 2) {
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x+a,y+b,p,threshold_ev,softness));
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x-a,y+b,p,threshold_ev,softness));
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x+a,y-b,p,threshold_ev,softness));
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x-a,y-b,p,threshold_ev,softness));
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x+b,y+a,p,threshold_ev,softness));
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x-b,y+a,p,threshold_ev,softness));
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x+b,y-a,p,threshold_ev,softness));
        sum=ys_add3(sum,ys_highlight_at(tex_r,tex_g,tex_b,w,h,x-b,y-a,p,threshold_ev,softness));
        count=16;
    }
    return ys_scale(sum,1.0f/(float)count);
}
__DEVICE__ float3 ys_spread_source(__TEXTURE__ tex_r,__TEXTURE__ tex_g,__TEXTURE__ tex_b,
    int w,int h,int x,int y,YSSpatialParams p,float radius_ref,int quality,
    float threshold_ev,float softness) {
    float scale=(float)h/2160.0f;
    int outer=(int)(_fmaxf(1.0f,radius_ref*scale)+0.5f);
    int inner=(int)(_fmaxf(1.0f,(float)outer*0.48f)+0.5f);
    float3 nearv=ys_ring_source(tex_r,tex_g,tex_b,w,h,x,y,p,inner,quality,threshold_ev,softness);
    float3 farv=ys_ring_source(tex_r,tex_g,tex_b,w,h,x,y,p,outer,quality,threshold_ev,softness);
    float3 blur=ys_mix(nearv,farv,0.62f);
    float3 center=ys_highlight_at(tex_r,tex_g,tex_b,w,h,x,y,p,threshold_ev,softness);
    return ys_sub_pos(blur,center);
}
__DEVICE__ float3 ys_halation_color(float3 spread,float tint_value) {
    float lum=_fmaxf(ys_Y709(ys_to709(spread)),0.0f);
    float3 red=make_float3(1.0f,0.055f,0.012f);
    float3 orange=make_float3(1.0f,0.30f,0.045f);
    return ys_scale(ys_mix(red,orange,ys_sat(tint_value)),lum);
}
__DEVICE__ float3 ys_glow_color(float3 spread,float neutral_mix) {
    float y=_fmaxf(ys_Y(spread),0.0f);
    return ys_mix(spread,ys_gray(y),ys_sat(neutral_mix));
}
__DEVICE__ float3 ys_optics_view(float3 contribution,float gain_value,float gray_code,int compress,float knee) {
    return ys_view(ys_scale(ys_pos3(contribution),gain_value),gray_code,compress,knee);
}


__DEVICE__ uint ys_grain_phase(int cadence) {
    uint f=(uint)TIMELINE_FRAME_INDEX;
    if (cadence == 0) return 0u;
    if (cadence == 2) return f/2u;
    if (cadence == 3) return f/3u;
    return f;
}
__DEVICE__ uint ys_seed_xy(int ix,int iy,uint phase,uint base_seed,uint salt) {
    return (uint)(ix+4099)*1973u + (uint)(iy+8191)*9277u + phase*26699u + base_seed*31847u + salt*1013u;
}
__DEVICE__ float ys_noise_corner(int ix,int iy,uint phase,uint base_seed,uint salt) {
    return RAND(ys_seed_xy(ix,iy,phase,base_seed,salt))*2.0f-1.0f;
}
__DEVICE__ float ys_value_noise(float gx,float gy,uint phase,uint base_seed,uint salt) {
    int ix=(int)_floorf(gx), iy=(int)_floorf(gy);
    float fx=gx-(float)ix, fy=gy-(float)iy;
    float sx=fx*fx*(3.0f-2.0f*fx), sy=fy*fy*(3.0f-2.0f*fy);
    float n00=ys_noise_corner(ix,iy,phase,base_seed,salt);
    float n10=ys_noise_corner(ix+1,iy,phase,base_seed,salt);
    float n01=ys_noise_corner(ix,iy+1,phase,base_seed,salt);
    float n11=ys_noise_corner(ix+1,iy+1,phase,base_seed,salt);
    float nx0=n00+(n10-n00)*sx, nx1=n01+(n11-n01)*sx;
    return nx0+(nx1-nx0)*sy;
}
__DEVICE__ float ys_gauge_base(int gauge_kind) {
    if (gauge_kind == 0) return 2.65f;
    if (gauge_kind == 1) return 1.75f;
    if (gauge_kind == 2) return 1.05f;
    if (gauge_kind == 3) return 0.72f;
    return 1.0f;
}
__DEVICE__ float ys_grain_cell(int gauge_kind,int size_pct,int image_h) {
    float cell=ys_gauge_base(gauge_kind)*((float)size_pct*0.01f)*((float)image_h/2160.0f);
    return _fmaxf(cell,0.01f);
}
__DEVICE__ float ys_grain_fractal(float x,float y,float cell,uint phase,uint base_seed,uint salt,float roughness) {
    float a=ys_value_noise(x/cell,y/cell,phase,base_seed,salt);
    float b=ys_value_noise(x/(cell*0.55f)+13.7f,y/(cell*0.55f)+7.1f,phase,base_seed,salt+17u);
    float c=ys_value_noise(x/(cell*1.9f)+3.9f,y/(cell*1.9f)+19.3f,phase,base_seed,salt+41u);
    float layered=0.64f*a+0.25f*b+0.11f*c;
    return a+(layered-a)*ys_sat(roughness);
}
__DEVICE__ float3 ys_grain_noise(int x,int y,int h,int gauge_kind,int size_pct,int rough_pct,int color_pct,
    int cadence,uint base_seed) {
    float cell=ys_grain_cell(gauge_kind,size_pct,h);
    uint phase=ys_grain_phase(cadence);
    float rough=(float)rough_pct*0.01f, color_mix=(float)color_pct*0.01f;
    float shared=ys_grain_fractal((float)x,(float)y,cell,phase,base_seed,11u,rough);
    float nr=ys_grain_fractal((float)x+2.1f,(float)y+7.3f,cell*1.08f,phase,base_seed,101u,rough);
    float ng=ys_grain_fractal((float)x+11.7f,(float)y+3.2f,cell,phase,base_seed,211u,rough);
    float nb=ys_grain_fractal((float)x+5.4f,(float)y+15.1f,cell*0.92f,phase,base_seed,307u,rough);
    return make_float3(shared+(nr-shared)*color_mix,shared+(ng-shared)*color_mix,shared+(nb-shared)*color_mix);
}
__DEVICE__ float ys_grain_exposure_weight(float3 image,int shadow_pct,int mid_pct,int high_pct) {
    float y=ys_Y(image);
    if (y <= 1.0e-10f) return 0.0f;
    float ev=ys_stops(y,0.18f);
    float sh=1.0f-ys_smooth(-3.5f,-0.5f,ev);
    float hi=ys_smooth(0.75f,5.0f,ev);
    float mid=_fmaxf(0.0f,1.0f-sh-hi);
    return sh*((float)shadow_pct*0.01f)+mid*((float)mid_pct*0.01f)+hi*((float)high_pct*0.01f);
}
__DEVICE__ float3 ys_apply_density_grain(float3 image,float3 noise,float weight,int amount_pct) {
    float density=0.00045f*(float)amount_pct*weight;
    return make_float3(image.x*_powf(10.0f,-density*noise.x),
                       image.y*_powf(10.0f,-density*noise.y),
                       image.z*_powf(10.0f,-density*noise.z));
}
__DEVICE__ float3 ys_abs3(float3 v) { return make_float3(_fabs(v.x),_fabs(v.y),_fabs(v.z)); }
__DEVICE__ float3 ys_local_balanced_blur(__TEXTURE__ tex_r,__TEXTURE__ tex_g,__TEXTURE__ tex_b,
    int w,int h,int x,int y,YSSpatialParams p,int radius_ref) {
    int r=(int)(_fmaxf(1.0f,(float)radius_ref*((float)h/2160.0f))+0.5f);
    int d=(int)((float)r*0.70710678f+0.5f);
    float3 center=ys_sample_balanced(tex_r,tex_g,tex_b,w,h,x,y,p);
    float3 sum=ys_scale(center,4.0f);
    sum=ys_add3(sum,ys_scale(ys_sample_balanced(tex_r,tex_g,tex_b,w,h,x+r,y,p),2.0f));
    sum=ys_add3(sum,ys_scale(ys_sample_balanced(tex_r,tex_g,tex_b,w,h,x-r,y,p),2.0f));
    sum=ys_add3(sum,ys_scale(ys_sample_balanced(tex_r,tex_g,tex_b,w,h,x,y+r,p),2.0f));
    sum=ys_add3(sum,ys_scale(ys_sample_balanced(tex_r,tex_g,tex_b,w,h,x,y-r,p),2.0f));
    sum=ys_add3(sum,ys_sample_balanced(tex_r,tex_g,tex_b,w,h,x+d,y+d,p));
    sum=ys_add3(sum,ys_sample_balanced(tex_r,tex_g,tex_b,w,h,x-d,y+d,p));
    sum=ys_add3(sum,ys_sample_balanced(tex_r,tex_g,tex_b,w,h,x+d,y-d,p));
    sum=ys_add3(sum,ys_sample_balanced(tex_r,tex_g,tex_b,w,h,x-d,y-d,p));
    return ys_scale(sum,1.0f/16.0f);
}
__DEVICE__ float3 ys_micro_soften(float3 center,float3 blur,float amount) {
    float yc=ys_Y(center), yb=ys_Y(blur);
    if (yc <= 1.0e-10f) return center;
    return ys_scale(center,(yc+(yb-yc)*ys_sat(amount))/yc);
}
__DEVICE__ float3 ys_texture_debug_signed(float3 signal,float gain_value) {
    return ys_clip(make_float3(0.5f+signal.x*gain_value,0.5f+signal.y*gain_value,0.5f+signal.z*gain_value));
}

__DEVICE__ float ys_vignette(int w,int h,int x,int y,float radius,float feather,float roundness,float cx,float cy) {
    float aspect = (float)w/(float)h;
    float nx = (2.0f*((float)x+0.5f)/(float)w-1.0f-cx)*aspect;
    float ny = 2.0f*((float)y+0.5f)/(float)h-1.0f-cy;
    nx /= 1.0f+(aspect-1.0f)*(1.0f-roundness);
    return ys_smooth(radius,radius+feather,_sqrtf(nx*nx+ny*ny));
}

typedef struct {
    float3 source; float3 balanced; float3 optical; float3 negative; float3 look; float3 print;
    float3 texture; float3 lens; float3 halation; float3 bloom; float3 glow; float3 veil;
    float3 grain_signal; float3 grain_delta; float grain_weight; float3 lens_delta;
    float3 pre; float3 output; float compression;
} YSStages;
typedef struct {
    int mode; int tap; int stage; int span; int step; int legend;
    float gray; float evlo; float evhi; float evsoft;
    float hue; float width; float soft; float smin; float smax; float ymin; float ymax;
    float skinh; float skinw; float skinsmin; float skinsmax;
    float neutral; float gain; float opacity; float split;
    int target_kind; float target_margin;
    int cal_kind; float cal_target_value; float cal_tol_ev; float cal_neutral_xy;
} YSDiag;
__DEVICE__ float ys_quantize(float ev,int step) {
    if (step == 0) return ev;
    float n = step == 1 ? 1.0f : (step == 2 ? 2.0f : 3.0f);
    return _floorf(ev*n+0.5f)/n;
}
__DEVICE__ float3 ys_heat(float t) {
    t = ys_sat(t);
    if (t < 0.25f) return ys_mix(make_float3(0.07f,0.03f,0.25f),make_float3(0.0f,0.55f,0.95f),t*4.0f);
    if (t < 0.5f) return ys_mix(make_float3(0.0f,0.55f,0.95f),make_float3(0.1f,0.75f,0.15f),(t-0.25f)*4.0f);
    if (t < 0.75f) return ys_mix(make_float3(0.1f,0.75f,0.15f),make_float3(1.0f,0.85f,0.05f),(t-0.5f)*4.0f);
    return ys_mix(make_float3(1.0f,0.85f,0.05f),make_float3(0.95f,0.05f,0.15f),(t-0.75f)*4.0f);
}
__DEVICE__ float3 ys_ev_color(float ev,int span,int step) {
    return ys_heat(0.5f+ys_quantize(ev,step)/(2.0f*(float)span));
}
__DEVICE__ float3 ys_hue_color(float hue) {
    float t = hue/60.0f;
    float r = ys_sat(_fabs(t-3.0f)-1.0f);
    float g = ys_sat(2.0f-_fabs(t-2.0f));
    float b = ys_sat(2.0f-_fabs(t-4.0f));
    return make_float3(r,g,b);
}
__DEVICE__ float ys_color_mask(float3 rgb,YSDiag d) {
    float3 hsv = ys_hsv(rgb);
    if (hsv.y < 1.0e-6f && d.width < 180.0f) return 0.0f;
    return ys_hue_weight(hsv.x,d.hue,d.width,d.soft)*ys_band(hsv.y,d.smin,d.smax,0.02f)
        *ys_band(ys_yprime(rgb),d.ymin,d.ymax,0.02f);
}
__DEVICE__ float3 ys_error(int x,int y) {
    return ((x/16+y/16)%2) == 0 ? make_float3(1.0f,0.0f,0.65f) : ys_gray(0.05f);
}
// Tiny original procedural digits for the exposure scale. No font assets.
__DEVICE__ int ys_digit(int digit,int x,int y) {
    if (x < 0 || x > 2 || y < 0 || y > 4) return 0;
    int bits = 0;
    if (digit == 0) bits = 31599; else if (digit == 1) bits = 11415;
    else if (digit == 2) bits = 29671; else if (digit == 3) bits = 29647;
    else if (digit == 4) bits = 23497; else if (digit == 5) bits = 31183;
    else if (digit == 6) bits = 31215; else if (digit == 7) bits = 29257;
    else if (digit == 8) bits = 31727; else if (digit == 9) bits = 31695;
    return (bits >> (14-(y*3+x))) & 1;
}
__DEVICE__ int ys_number(int number,int x,int y) {
    if (number < 0) {
        if (x < 4) return y == 2 && x >= 0 && x <= 2;
        x -= 4; number = -number;
    }
    if (number >= 10) {
        if (x < 4) return ys_digit(number/10,x,y);
        x -= 4;
    }
    return ys_digit(number%10,x,y);
}
__DEVICE__ float3 ys_legend(float3 image,int w,int h,int x,int y,YSDiag d) {
    // Warning strip is deliberately non-optional whenever diagnostics are active.
    if (y < _fmaxf(3.0f,(float)h*0.009f))
        return ((x/12)%2) == 0 ? make_float3(1.0f,0.6f,0.0f) : ys_gray(0.04f);
    int exposure_mode = d.mode >= 1 && d.mode <= 6;
    if (!d.legend || !exposure_mode || w < 320 || h < 160 || y < (int)((float)h*0.90f)) return image;
    int bands = 2*d.span+1;
    float bw = (float)w/(float)bands;
    int index = (int)((float)x/bw); if (index >= bands) index = bands-1;
    int ev = index-d.span;
    int bar_end = (int)((float)h*0.943f);
    if (y < bar_end) {
        if (d.mode == 2) return ys_gray(ys_sat(0.5f+(float)ev/(2.0f*(float)d.span)));
        if (d.mode == 3) return ys_gray(ys_sat(((float)ev+5.0f)/10.0f));
        if (d.mode == 4 || d.mode == 5) return ys_gray(ys_band((float)ev,d.evlo,d.evhi,d.evsoft));
        if (d.mode == 6) return ys_gray(ys_sat(0.5f+(float)ev/(2.0f*(float)d.span)));
        return ys_ev_color((float)ev,d.span,d.step);
    }
    int scale = (int)_fmaxf(1.0f,_fminf((float)h/150.0f,bw/14.0f));
    int digits = (ev < 0 ? 1 : 0)+(_fabs((float)ev) >= 10.0f ? 2 : 1);
    int origin = (int)(((float)index+0.5f)*bw)-(digits*4-1)*scale/2;
    int top = bar_end+2*scale;
    if (x >= origin && y >= top && ys_number(ev,(x-origin)/scale,(y-top)/scale)) return ys_gray(0.95f);
    return ys_gray(0.025f);
}
__DEVICE__ float3 ys_diagnostic(YSStages s,YSDiag d,float gray_code,int compress,float knee,int w,int h,int x,int y) {
    float3 tap = d.tap == 0 ? s.source : s.balanced;
    float yscene = ys_Y(tap), ev = ys_stops(yscene,d.gray);
    float3 rgb = s.output, hsv = ys_hsv(rgb), result = rgb;
    float yp = ys_yprime(rgb);
    float mask = ys_color_mask(rgb,d);
    float skin = ys_skin(tap,d.skinh,d.skinw,d.skinsmin,d.skinsmax);
    float selection = yscene > 0.0f ? ys_band(ev,d.evlo,d.evhi,d.evsoft) : 0.0f;
    if (d.mode == 1) result = yscene > 0.0f ? ys_ev_color(ev,d.span,d.step) : ys_gray(0.0f);
    else if (d.mode == 2) result = ys_gray(ys_sat(0.5f+ys_quantize(ev,d.step)/(2.0f*(float)d.span)));
    else if (d.mode == 3) result = ys_gray(ys_sat((_floorf(ev+0.5f)+5.0f)/10.0f));
    else if (d.mode == 4) result = ys_gray(selection);
    else if (d.mode == 5) result = ys_mix(rgb,make_float3(0.1f,1.0f,0.35f),selection*d.opacity);
    else if (d.mode == 6) result = make_float3(ys_sat(0.5f+ys_stops(tap.x,d.gray)/(2.0f*(float)d.span)),
        ys_sat(0.5f+ys_stops(tap.y,d.gray)/(2.0f*(float)d.span)),ys_sat(0.5f+ys_stops(tap.z,d.gray)/(2.0f*(float)d.span)));
    else if (d.mode == 7) result = ys_gray(yp);
    else if (d.mode == 8) result = ys_heat(yp);
    else if (d.mode == 9) {
        float3 linear = make_float3(_powf(rgb.x,2.4f),_powf(rgb.y,2.4f),_powf(rgb.z,2.4f));
        result = ys_gamma24(ys_gray(ys_Y709(linear)));
    }
    else if (d.mode == 10) result = hsv.y > 1.0e-5f ? ys_hue_color(hsv.x) : ys_gray(0.35f);
    else if (d.mode == 11) result = ys_heat(hsv.y);
    else if (d.mode == 12) result = ys_heat(ys_max(rgb)-ys_min(rgb));
    else if (d.mode == 13) result = ys_gray(mask);
    else if (d.mode == 14) result = ys_mix(ys_gray(yp*0.35f),rgb,mask);
    else if (d.mode == 15) result = ys_gray(skin);
    else if (d.mode == 16) result = ys_mix(ys_gray(0.08f),ys_ev_color(ev,d.span,d.step),skin);
    else if (d.mode == 17) {
        result = hsv.y <= d.neutral ? ys_clip(make_float3(0.5f+(rgb.x-yp)*d.gain,
            0.5f+(rgb.y-yp)*d.gain,0.5f+(rgb.z-yp)*d.gain)) : ys_gray(0.12f);
    }
    else if (d.mode == 18) result = make_float3(tap.x <= 0.0f ? 1.0f : 0.0f,tap.y <= 0.0f ? 1.0f : 0.0f,tap.z <= 0.0f ? 1.0f : 0.0f);
    else if (d.mode == 19) {
        if (ys_min(s.pre) < -1.0e-6f) result = ys_error(x,y);
        else result = make_float3(s.pre.x >= 0.995f ? 1.0f : 0.0f,s.pre.y >= 0.995f ? 1.0f : 0.0f,s.pre.z >= 0.995f ? 1.0f : 0.0f);
    }
    else if (d.mode == 20) {
        float3 p = ys_to709(s.lens); float ly = ys_Y709(p);
        if (ly <= 1.0e-8f) result = ys_gray(0.15f);
        else if (ys_min(p) < -1.0e-6f*ly) result = make_float3(1.0f,0.05f,0.1f);
        else if (ys_min(p)/ly < 0.02f) result = make_float3(1.0f,0.75f,0.0f);
        else result = make_float3(0.1f,0.65f,0.2f);
    }
    else if (d.mode == 21) {
        if (ys_min(s.pre) < -1.0e-6f || ys_max(s.pre) > 1.000001f) result = make_float3(1.0f,0.05f,0.1f);
        else if (ys_min(s.pre) < 0.01f || ys_max(s.pre) > 0.99f) result = make_float3(1.0f,0.75f,0.0f);
        else result = make_float3(0.1f,0.65f,0.2f);
    }
    else if (d.mode == 22) result = ys_gray(s.compression);
    else if (d.mode == 23) result = (float)x < (float)w*d.split ? ys_view(s.balanced,gray_code,compress,knee) : rgb;
    else if (d.mode == 24) {
        float3 before = ys_view(s.balanced,gray_code,compress,knee);
        result = ys_clip(make_float3(_fabs(rgb.x-before.x)*d.gain,_fabs(rgb.y-before.y)*d.gain,_fabs(rgb.z-before.z)*d.gain));
    }
    else if (d.mode == 25) {
        float3 v = s.source;
        if (d.stage == 1) v = s.balanced; else if (d.stage == 2) v = s.negative;
        else if (d.stage == 3) v = s.look; else if (d.stage == 4) v = s.print;
        else if (d.stage == 5) v = s.lens;
        result = d.stage == 7 ? rgb : (d.stage == 6 ? ys_gamma24(s.pre) : ys_view(v,gray_code,compress,knee));
    }
    else if (d.mode == 26) result = ys_gray(0.0f); // Unsafe inputs exit before any transforms.
    else if (d.mode == 27) {
        float3 target=ys_target_pre(s.lens,d.target_kind,gray_code);
        result=ys_target_status(target,d.target_margin);
    }
    else if (d.mode == 28) {
        float3 target=ys_target_pre(s.lens,d.target_kind,gray_code);
        float occ=ys_target_occupancy(target,d.target_kind);
        result=occ > 1.0f ? make_float3(1.0f,0.0f,0.65f) : ys_heat(ys_sat(occ));
    }
    else if (d.mode == 29) {
        float3 target=ys_target_pre(s.lens,d.target_kind,gray_code);
        float head=ys_target_headroom(target);
        if (head < 0.0f) result=make_float3(1.0f,0.05f,0.10f);
        else {
            float safe=ys_sat(head/_fmaxf(5.0f*d.target_margin,1.0e-5f));
            result=ys_mix(make_float3(1.0f,0.75f,0.0f),make_float3(0.10f,0.65f,0.20f),safe);
        }
    }
    else if (d.mode == 30) {
        float target=_fmaxf(d.cal_target_value,1.0e-6f);
        float err=ys_stops(ys_Y(tap),target);
        result=ys_cal_ev_color(err,d.cal_tol_ev);
    }
    else if (d.mode == 31) {
        result=ys_cal_neutral_color(ys_neutral_xy_error(tap),d.cal_neutral_xy);
    }
    else if (d.mode == 32) {
        float target=_fmaxf(d.cal_target_value,1.0e-6f);
        float err=ys_stops(ys_Y(tap),target);
        float ne=ys_neutral_xy_error(tap);
        int ev_ok=_fabs(err) <= d.cal_tol_ev;
        int n_ok=ne <= d.cal_neutral_xy;
        if (ev_ok && n_ok) result=make_float3(0.10f,0.75f,0.20f);
        else if (!ev_ok && !n_ok) result=make_float3(0.95f,0.05f,0.15f);
        else if (!ev_ok) result=ys_cal_ev_color(err,d.cal_tol_ev);
        else result=make_float3(0.80f,0.15f,0.85f);
    }
    return ys_legend(result,w,h,x,y,d);
}


// Optional viewer graphics. These are read-only rendered overlays, not OFX mouse widgets.
__DEVICE__ float ys_picker_hue(float3 swatch, float fallback) {
    if (!ys_safe(swatch) || ys_min(swatch) < 0.0f || ys_max(swatch) > 1.0f) return fallback;
    float3 h = ys_hsv(swatch);
    return h.y > 1.0e-5f ? h.x : fallback;
}
__DEVICE__ int ys_glyph(int c,int x,int y) {
    if (x < 0 || x > 2 || y < 0 || y > 4) return 0;
    if (c >= 48 && c <= 57) return ys_digit(c-48,x,y);
    int bits = 0;
    if (c == 65) bits = 11245;
    if (c == 66) bits = 27566;
    if (c == 67) bits = 14627;
    if (c == 68) bits = 27502;
    if (c == 69) bits = 31143;
    if (c == 70) bits = 31140;
    if (c == 71) bits = 14699;
    if (c == 72) bits = 23533;
    if (c == 73) bits = 29847;
    if (c == 74) bits = 4714;
    if (c == 75) bits = 23469;
    if (c == 76) bits = 18727;
    if (c == 77) bits = 24557;
    if (c == 78) bits = 24573;
    if (c == 79) bits = 11114;
    if (c == 80) bits = 27556;
    if (c == 81) bits = 11131;
    if (c == 82) bits = 27565;
    if (c == 83) bits = 14478;
    if (c == 84) bits = 29842;
    if (c == 85) bits = 23407;
    if (c == 86) bits = 23402;
    if (c == 87) bits = 23549;
    if (c == 88) bits = 23213;
    if (c == 89) bits = 23186;
    if (c == 90) bits = 29351;
    return (bits >> (14-y*3-x)) & 1;
}
