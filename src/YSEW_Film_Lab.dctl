DEFINE_UI_PARAMS(grain_color, Grain Color, DCTLUI_SLIDER_INT, 18, 0, 100, 1)
DEFINE_UI_PARAMS(grain_shadow, Grain Shadow, DCTLUI_SLIDER_INT, 115, 0, 200, 1)
DEFINE_UI_PARAMS(grain_mid, Grain Mid, DCTLUI_SLIDER_INT, 100, 0, 200, 1)
DEFINE_UI_PARAMS(grain_high, Grain High, DCTLUI_SLIDER_INT, 55, 0, 200, 1)
