DEFINE_UI_PARAMS(skin_sat_max, Skin Sat Max, DCTLUI_SLIDER_FLOAT, 0.9, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(print_on, Print, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(print_contrast, Print Contrast, DCTLUI_SLIDER_FLOAT, 1.06, 0.5, 2.0, 0.01)
DEFINE_UI_PARAMS(print_toe, Print Toe, DCTLUI_SLIDER_FLOAT, 0.04, 0.0, 0.4, 0.01)
DEFINE_UI_PARAMS(print_shoulder, Print Shoulder, DCTLUI_SLIDER_FLOAT, 0.12, 0.0, 0.4, 0.01)
