// Yekermo Sew Film Lab 0.6.0-alpha.1 - M6 advanced gamut, volume and scene-calibration diagnostics.
// Original parametric creative models, NOT measured film-stock emulations.
// Input must already be decoded RGB with the selected scene encoding.
// See docs/RESOLVE_SETUP.md and docs/DIAGNOSTICS.md before installation.
// Control IDs, types and enum order are a saved-grade contract. Append; do not reorder.
// UI labels and enum display labels are unquoted DCTL tokens, not C strings.
// UI numeric arguments use plain literals; float suffixes are for shader code only.

DEFINE_UI_PARAMS(input_mode, Input, DCTLUI_COMBO_BOX, 0, {IN_DI, IN_DWG, IN_709_LINEAR, IN_LOGC4, IN_SLOG3_CINE, IN_SLOG3_G3, IN_LOG3G10}, {DWG Intermediate, DWG Linear, 709 Scene Linear, ARRI LogC4, Sony SLog3 Cine, Sony SLog3 G3, RED Log3G10})
DEFINE_UI_PARAMS(output_mode, Output, DCTLUI_COMBO_BOX, 2, {OUT_DI, OUT_DWG, OUT_709}, {DWG Intermediate, DWG Linear, 709 Gamma 2.4})
DEFINE_UI_PARAMS(exposure, Exposure, DCTLUI_SLIDER_FLOAT, 0.0, -10.0, 10.0, 0.01)
DEFINE_UI_PARAMS(warm, Warmth, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(tint, Tint, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(printer_r, Density R, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.1)
DEFINE_UI_PARAMS(printer_g, Density G, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.1)
DEFINE_UI_PARAMS(printer_b, Density B, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.1)
DEFINE_UI_PARAMS(negative_on, Negative, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(neg_contrast, Neg Contrast, DCTLUI_SLIDER_FLOAT, 1.08, 0.5, 2.0, 0.01)
DEFINE_UI_PARAMS(neg_toe, Neg Toe, DCTLUI_SLIDER_FLOAT, 0.08, 0.0, 0.4, 0.01)
DEFINE_UI_PARAMS(neg_shoulder, Neg Shoulder, DCTLUI_SLIDER_FLOAT, 0.16, 0.0, 0.4, 0.01)
DEFINE_UI_PARAMS(neg_sat, Neg Saturation, DCTLUI_SLIDER_FLOAT, 0.98, 0.0, 1.5, 0.01)
DEFINE_UI_PARAMS(crosstalk, Neg Crosstalk, DCTLUI_SLIDER_FLOAT, 0.025, 0.0, 0.2, 0.001)
DEFINE_UI_PARAMS(look_mode, Show Look, DCTLUI_COMBO_BOX, 0, {LOOK_NEUTRAL, LOOK_FALL, LOOK_WINTER}, {Neutral, Fall Interior, Winter Interior})
DEFINE_UI_PARAMS(look_mix, Look Mix, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(skin_protect, Skin Protect, DCTLUI_SLIDER_FLOAT, 0.75, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(skin_hue, Skin Hue, DCTLUI_SLIDER_FLOAT, 28.0, 0.0, 360.0, 1.0)
