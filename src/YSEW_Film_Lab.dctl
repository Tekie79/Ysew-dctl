        if (index == 3) return 79;
        if (index == 4) return 82;
        if (index == 6) return 72;
        if (index == 7) return 85;
        if (index == 8) return 69;
        if (index == 10) return 83;
        if (index == 11) return 65;
        if (index == 12) return 84;
    }
    if (label == 5) {
        if (index == 0) return 83;
        if (index == 1) return 75;
        if (index == 2) return 73;
        if (index == 3) return 78;
        if (index == 5) return 72;
        if (index == 6) return 85;
        if (index == 7) return 69;
        if (index == 9) return 83;
