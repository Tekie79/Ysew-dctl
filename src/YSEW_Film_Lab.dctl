// M6 diagnostic target and scene-calibration controls. They never alter normal output.
DEFINE_UI_PARAMS(diag_gamut, Diag Gamut, DCTLUI_COMBO_BOX, 0, {DG_709, DG_P3D65, DG_2020}, {Rec709, P3 D65, Rec2020})
DEFINE_UI_PARAMS(gamut_margin, Gamut Margin x1k, DCTLUI_SLIDER_INT, 20, 1, 250, 1)
