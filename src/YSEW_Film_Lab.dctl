DEFINE_UI_PARAMS(range_ymax, Range Luma Max, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(neutral_tol, Neutral Limit, DCTLUI_SLIDER_FLOAT, 0.12, 0.01, 0.5, 0.01)
DEFINE_UI_PARAMS(diag_gain, Diag Gain, DCTLUI_SLIDER_FLOAT, 4.0, 1.0, 20.0, 0.5)
DEFINE_UI_PARAMS(diag_overlay, Overlay, DCTLUI_SLIDER_FLOAT, 0.65, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(split_pos, Split, DCTLUI_SLIDER_FLOAT, 0.5, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(diag_legend, EV Legend, DCTLUI_CHECK_BOX, 1)


// Optional graphics. All new features default off; original color pipeline is unchanged.
DEFINE_UI_PARAMS(range_pick, Range Color, DCTLUI_COLOR_PICKER, 0.70, 0.42, 0.175)
DEFINE_UI_PARAMS(skin_pick, Skin Color, DCTLUI_COLOR_PICKER, 0.70, 0.42, 0.175)
