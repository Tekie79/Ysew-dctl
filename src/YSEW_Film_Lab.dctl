DEFINE_UI_PARAMS(adv_print_warm, Print Warm, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(adv_print_color, Print Color, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.5, 0.01)

// M4 spatial optics. Disabled by default; radii are reference pixels at 2160 lines.
DEFINE_UI_PARAMS(optics_on, Optics, DCTLUI_CHECK_BOX, 0)
